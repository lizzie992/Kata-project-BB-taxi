@page "/Account/ConfirmEmail"

@using System.Text
@using BB
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BaxiWebApp.Data
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@using System.Globalization;
@using Components.Pages.Res;
@inject UserManager<User> UserManager
@inject IdentityRedirectManager RedirectManager
@inject Data.DataService DataService

<PageTitle>@localizer["Confirm_email"]</PageTitle>

<h1>@localizer["Confirm_email"]</h1>
<StatusMessage Message=@localizer[@statusMessage, UserId] />

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Error loading user with ID {UserId}";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            statusMessage = result.Succeeded ? "Thank you for confirming your email." : "Error confirming your email.";
        }
    }
    protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

    public async void OnCultureChanged(object sender, CultureInfo culture)
    {

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

}
