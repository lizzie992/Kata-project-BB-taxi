@page "/Account/ResetPasswordConfirmation"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@using Microsoft.AspNetCore.Identity
@using System.Globalization;
@using Components.Pages.Res;
@using BB
@inject IdentityRedirectManager RedirectManager
@inject Data.DataService DataService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider;

<PageTitle>@localizer["Reset_password_confirmation"]</PageTitle>

<h1>@localizer["Reset_password_confirmation"]</h1>
<p>@localizer["Your_password_has_been_reset_please_log_in"]</p>

@code{

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{
		await InvokeAsync(() =>
	{
		StateHasChanged();
	});
	}

    User currentlyLoggedInUser;

    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        currentlyLoggedInUser = await UserManager.GetUserAsync(claims);

    }

    protected override async Task OnParametersSetAsync()
    {
        identifyLoggedInUser().GetAwaiter().GetResult();
        base.OnParametersSet();
    }
    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        if (firstrender)
        {
            DataService.loadCulture(currentlyLoggedInUser);
        }
    }

}