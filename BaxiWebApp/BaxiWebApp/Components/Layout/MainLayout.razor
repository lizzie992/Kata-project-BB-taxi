@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Pages.Res;
@using BB;
@using Microsoft.Extensions.Localization
@using System.Globalization
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Identity;
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject Data.BaxiWebAppContext context;
@using Microsoft.EntityFrameworkCore
@using System.Text.Json

<CascadingValue Name="currentlyLoggedInUser" Value=@currentlyLoggedInUser>
	<div class="page">
		<div class="sidebar">
			<NavMenu />
		</div>

		<main>
			<div class="top-row px-4">
				@if (currentlyLoggedInUser is not null)
				{
					<div class="languageSelection">
						<InputSelect @bind-Value="currentlyLoggedInUser.Culture" @onchange="(e) => DataService.ChangeCulture(e, currentlyLoggedInUser)">
							<option value="de-DE">@localizer["German"]</option>
							<option value="en-GB">@localizer["English"]</option>
						</InputSelect>
					</div>
				}
				<div class="impressum-privacy">
					<a href="https://baxi.taxi/Impressum" target="_blank">Impressum</a>
					<a href="https://baxi.taxi/PrivacyPolicy" target="_blank">Privacy Policy</a>
				</div>
				@* <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a> *@
			</div>

			<article class="content px-4">
				@Body
			</article>
		</main>
	</div>

	<div id="blazor-error-ui">
		An unhandled error has occurred.
		<a href="" class="reload">Reload</a>
		<a class="dismiss">🗙</a>
	</div>
</CascadingValue>


@code {

	protected override async Task OnParametersSetAsync()
	{
		await identifyLoggedInUser();
		DataService.loadCulture(currentlyLoggedInUser);
		base.OnParametersSet();
	}



	protected override async Task OnInitializedAsync()
	{
		await identifyLoggedInUser();
	}

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object? sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}

	public User? currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
		StateHasChanged();
	}

	// protected override void OnAfterRender(bool firstrender)
	// {
	// 	if (firstrender)
	// 	{
	// 		DataService.loadCulture(currentlyLoggedInUser);
	// 	}
	// }

	protected override bool ShouldRender()
	{
		DataService.loadCulture(currentlyLoggedInUser);
		return base.ShouldRender();
	}

}