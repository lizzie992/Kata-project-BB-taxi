@code {

	private static Ad ad { get; set; } = new();


	//coordinates of Baierbrunn
	public double latitudeBB = 48.0206345131560;
	public double longitudeBB = 11.482919688669709;

	Timer timerObj = new();

	protected override void OnParametersSet()
	{
		IdentifyLoggedInUser().GetAwaiter().GetResult();
		ad = new Ad();
		ad.AdOwner = _currentlyLoggedInUser;
		ad.AdType = _currentlyLoggedInUser.DefaultAdType;
		ad.AdDirection = CreateAd.ad.AdDirection;
		ad.PickUpDropOffLocation = _currentlyLoggedInUser.DefaultPickUpAddress;
		ad.PickUpDateAndTime = DateTime.Today.AddDays(1);
		ad.PickUpDateAndTime = CreateAd.ad.PickUpDateAndTime;
		ad.NumberOfSeats = _currentlyLoggedInUser.DefaultNumberOfSeats;
		ad.SpecificRequests = _currentlyLoggedInUser.DefaultSpecificRequests;

		timerObj = new Timer(1500);
		timerObj.Elapsed += onTimer;
		timerObj.AutoReset = false;

		base.OnParametersSet();
	}

	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			if (_currentlyLoggedInUser.DefaultLatitude >= 1 && _currentlyLoggedInUser.DefaultLongitude >= 1)
			{
				showMap = true;
				await InvokeAsync(() =>
			{
				StateHasChanged();
			});
				await JSRuntime.InvokeVoidAsync("initMapForCreatingAd", _currentlyLoggedInUser.DefaultLatitude, _currentlyLoggedInUser.DefaultLongitude);
			}
		}
	}

	/// <summary>
	/// Restarts the timer any time the user types a new input in this field
	/// </summary>
	/// <param name="e"></param>
	private void OnValueChange(KeyboardEventArgs e)
	{
		// remove previous one
		timerObj.Stop();
		// new timer
		timerObj.Start();
	}

	/// <summary>
	/// As the timer elapses, it triggers the method to show the map with the address given by the user
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="e"></param>
	public void onTimer(object? sender, ElapsedEventArgs e)
	{
		showMapWithAddress();
	}

	/// <summary>
	/// Closes pop up window with error message about incorrect address
	/// </summary>
	bool popUpForWrongCoordinates = false;
	public void ClosePopUpForWrongCoordinates()
	{
		popUpForWrongCoordinates = false;
	}
	/// <summary>
	/// Opens pop up window with error message about incorrect address
	/// </summary>
	public void ShowPopUpForWrongCoordinates()
	{
		popUpForWrongCoordinates = true;
	}


	bool showMap = false;

	/// <summary>
	/// Executes multiple checks if the address / coordinates given by the user are correct and valid, is there an existing route between the location and Baierbrunn, and if it is too close or too far from Baierbrunn
	/// If the checks return as acceptable, it triggers the map (using Google API) showing the marker set on the location that was given by the user
	/// </summary>
	/// <returns>bool</returns>
	public async Task showMapWithAddress()
	{
		(ad.Latitude, ad.Longitude) = await DataService.GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
		int distance = await DataService.GetDistance(latitudeBB, longitudeBB, ad.Latitude, ad.Longitude);
		if (distance == Constants.INVALID_ROUTE)
		{
			showMap = false;
			ShowPopUpForInvalidRoute();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else if (ad.Latitude == null || ad.Longitude == null)
		{
			showMap = false;
			ShowPopUpForWrongCoordinates();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else if (await DataService.IsItTooCloseToBB(distance))
		{
			showMap = false;
			ShowPopUpForTooClose();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else if (await DataService.IsItTooFarFromBB(distance))
		{
			showMap = false;
			ShowPopUpForTooFar();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else
		{
			showMap = true;
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
			await JSRuntime.InvokeVoidAsync("initMapForCreatingAd", ad.Latitude, ad.Longitude);
		}
	}

	/// <summary>
	/// Returns the Latitude of the location where the user placed the marker on the map (Using Google API and Javascript)
	/// </summary>
	/// <returns>double</returns>
	public async Task<double> GetLatitude()
	{
		double latitude = await JSRuntime.InvokeAsync<double>("getLatitude");
		return latitude;
	}
	/// <summary>
	/// Returns the Longitude of the location where the user placed the marker on the map (Using Google API and Javascript)
	/// </summary>
	/// <returns>double</returns>
	public async Task<double> GetLongitude()
	{
		double longitude = await JSRuntime.InvokeAsync<double>("getLongitude");
		return longitude;
	}

	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	private User _currentlyLoggedInUser;
	public async Task IdentifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		_currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	/// <summary>
	/// Compares the new Ad that was just created by the user with the existing ads, based on pick up time and the distance between the pickup / dropoff locations
	/// If they are close enough in time and in geographical location, it sends an email notification to both ad owners, which email will contain the details of the other ad
	/// </summary>
	/// <param name="newAd">Ad</param>
	/// <param name="adList"><List of Ads/param>
	/// <returns>bool</returns>
	public async Task CheckDistanceAndSendNotification(Ad newAd, List<Ad> adList)
	{
		foreach (Ad oldAd in adList)
		{
			if (await DataService.CheckDistanceBetweenAds(newAd, oldAd))
			{
				if (oldAd.AdOwner.AreNotificationsOn == true)
				{
					string messageNewAd = $"You might be interested in this new Ad:\r\n Ad type: {newAd.AdType}\r\nAd Direction: {newAd.AdDirection}\r\nAddress: {newAd.PickUpDropOffLocation}\r\n On {newAd.PickUpDateAndTime}\r\n Available seats: {newAd.NumberOfSeats}\r\n Any speicifc requests: {newAd.SpecificRequests}\r\n";
					string emailAddress = "gulyaskata99@gmail.com";
					string subject = "Check out this new ad: ";
					DataService.sendEmail(emailAddress, subject, messageNewAd);
				}
				if (newAd.AdOwner.AreNotificationsOn == true)
				{
					string messageOldAd = $"You might be interested in this new Ad:\r\n Ad type: {oldAd.AdType}\r\nAd Direction: {oldAd.AdDirection}\r\nAddress: {oldAd.PickUpDropOffLocation}\r\n On {oldAd.PickUpDateAndTime}\r\n Available seats: {oldAd.NumberOfSeats}\r\n Any speicifc requests: {oldAd.SpecificRequests}\r\n";
					string emailAddress = "gulyaskata99@gmail.com";
					string subject = "Check out this new ad: ";
					DataService.sendEmail(emailAddress, subject, messageOldAd);
				}
			}
			else if (await DataService.CheckMatchingRoutes(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude))
			{
				if (oldAd.AdOwner.AreNotificationsOn == true)
				{
					string messageNewAd = $"You might be interested in this new Ad:\r\n Ad type: {newAd.AdType}\r\nAd Direction: {newAd.AdDirection}\r\nAddress: {newAd.PickUpDropOffLocation}\r\n On {newAd.PickUpDateAndTime}\r\n Available seats: {newAd.NumberOfSeats}\r\n Any speicifc requests: {newAd.SpecificRequests}\r\n";
					string emailAddress = "gulyaskata99@gmail.com";
					string subject = "Check out this new ad: ";
					DataService.sendEmail(emailAddress, subject, messageNewAd);
				}
				if (newAd.AdOwner.AreNotificationsOn == true)
				{
					string messageOldAd = $"You might be interested in this new Ad:\r\n Ad type: {oldAd.AdType}\r\nAd Direction: {oldAd.AdDirection}\r\nAddress: {oldAd.PickUpDropOffLocation}\r\n On {oldAd.PickUpDateAndTime}\r\n Available seats: {oldAd.NumberOfSeats}\r\n Any speicifc requests: {oldAd.SpecificRequests}\r\n";
					string emailAddress = "gulyaskata99@gmail.com";
					string subject = "Check out this new ad: ";
					DataService.sendEmail(emailAddress, subject, messageOldAd);
				}
			}
	}	
	}

	/// <summary>
	/// Compares the new Ad that was just created by the user with the existing ads, based on ad type (drivers against passengers) and Direction (TO or FROM Baierbrunn)
	/// If there is a match, it triggers the CheckDistanceAndSendNotification method for further checks and possible email notifications
	/// </summary>
	/// <param name="newAd">Ad</param>
	/// <returns>bool</returns>
	public async Task CheckAdsForNotification(Ad newAd) //newAd is the ad that was just added, the oldAd is the ad that already existed - both will be subject of notifications, so if there is a match, both adowners will be notified
	{
		var adList = context.Ads.Include(u => u.AdOwner).ToList<Ad>().AsEnumerable();

		//TO Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Passenger)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Driver && oldAd.NumberOfSeats >= newAd.NumberOfSeats);
			await CheckDistanceAndSendNotification(newAd, adList.ToList());
		}

		//TO Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Passenger && oldAd.NumberOfSeats <= newAd.NumberOfSeats);
			await CheckDistanceAndSendNotification(newAd, adList.ToList());
		}


		//FROM Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Passenger)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Driver && oldAd.NumberOfSeats >= newAd.NumberOfSeats);
			await CheckDistanceAndSendNotification(newAd, adList.ToList());
		}

		//FROM Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Passenger && oldAd.NumberOfSeats <= newAd.NumberOfSeats);
			await CheckDistanceAndSendNotification(newAd, adList.ToList());
		}


	}





