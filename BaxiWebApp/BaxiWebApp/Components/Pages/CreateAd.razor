	</Authorized>
</AuthorizeView>

@code {

	private static Ad ad { get; set; } = new();

	private string anything = string.Empty;

	//coordinates of Baierbrunn
	public double latitudeBB = 48.0206345131560;
	public double longitudeBB = 11.482919688669709;

	Timer timerObj = new();

	protected override void OnParametersSet()
	{
		IdentifyLoggedInUser().GetAwaiter().GetResult();
		ad = new Ad();
		ad.AdOwner = _currentlyLoggedInUser;
		ad.AdType = CreateAd.ad.AdType;
		ad.AdDirection = CreateAd.ad.AdDirection;
		ad.PickUpDropOffLocation = CreateAd.ad.PickUpDropOffLocation;
		ad.PickUpDateAndTime = DateTime.Today.AddDays(1);
		ad.PickUpDateAndTime = CreateAd.ad.PickUpDateAndTime;
		ad.NumberOfSeats = CreateAd.ad.NumberOfSeats;
		ad.SpecificRequests = CreateAd.ad.SpecificRequests;


		timerObj = new Timer(1500);
		timerObj.Elapsed += onTimer;
		timerObj.AutoReset = false;

		base.OnParametersSet();
	}

	// protected override async Task OnAfterRenderAsync(bool firstrender)
	// {
	// 	if (firstrender)
	// 	{
	// 		await JSRuntime.InvokeVoidAsync("initMapForCreatingAd", latitudeBB, longitudeBB);
	// 	}
	// }
	private void OnValueChange(KeyboardEventArgs e)
	{
		// remove previous one
		timerObj.Stop();
		// new timer
		timerObj.Start();
	}

	public void onTimer(object? sender, ElapsedEventArgs e)
	{
		showMapWithAddress();
	}


	bool popUpForWrongCoordinates = false;
	public void ClosePopUpForWrongCoordinates()
	{
		popUpForWrongCoordinates = false;
	}
	public void ShowPopUpForWrongCoordinates()
	{
		popUpForWrongCoordinates = true;
	}


	bool showMap = false;


	public async Task showMapWithAddress()
	{
		(ad.Latitude, ad.Longitude) = await DataService.GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
		int distance = await DataService.GetDistance(latitudeBB, longitudeBB, ad.Latitude, ad.Longitude);
		if (ad.Latitude == null || ad.Longitude == null)
		{
			showMap = false;
			ShowPopUpForWrongCoordinates();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else if (await DataService.IsItTooCloseToBB(distance))
		{
			showMap = false;
			ShowPopUpForTooClose();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else if (await DataService.IsItTooFarFromBB(distance))
		{
			showMap = false;
			ShowPopUpForTooFar();
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
		}
		else
		{
			showMap = true;
			await InvokeAsync(() =>
			{
				StateHasChanged();
			});
			await JSRuntime.InvokeVoidAsync("initMapForCreatingAd", ad.Latitude, ad.Longitude);
		}
	}


	public async Task<double> GetLatitude()
	{
		double latitude = await JSRuntime.InvokeAsync<double>("getLatitude");
		return latitude;
	}

	public async Task<double> GetLongitude()
	{
		double longitude = await JSRuntime.InvokeAsync<double>("getLongitude");
		return longitude;
	}


	private User _currentlyLoggedInUser;
	public async Task IdentifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		_currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	public async void CheckDistanceForNotification(Ad newAd, List<Ad> adList)
	{
		//parameters to be defined:
		int distanceLimit = 5000; //PAY ATTENTION: METERS, NOT KILOMETERS, this is the limit of how many meters we calculate the notificaions for
		int timeLimit = 1; //this is to define what is the max difference in time between the 2 ads so that they can be relevant to each other

		foreach (Ad oldAd in adList)
		{
			int timeDifference = Math.Abs((int)Math.Round((oldAd.PickUpDateAndTime - newAd.PickUpDateAndTime).TotalHours));
			if (timeDifference <= timeLimit)
			{
				int distance = await DataService.GetDistance(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude);
				if (distance <= distanceLimit)
				{
					DataService.sendEmailNewAd(oldAd);
					DataService.sendEmailNewAd(newAd);
				}
			}
		}
	}

	public async void SendNotificationAboutAd(Ad newAd) //newAd is the ad that was just added, the oldAd is the ad that already existed - both will be subject of notifications, so if there is a match, both adowners will be notified
	{

		var adList = context.Ads.ToList<Ad>().AsEnumerable();

		//TO Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Passenger)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Driver && oldAd.NumberOfSeats >= newAd.NumberOfSeats);
			CheckDistanceForNotification(newAd, adList.ToList());
		}

		//TO Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Passenger && oldAd.NumberOfSeats <= newAd.NumberOfSeats);
			CheckDistanceForNotification(newAd, adList.ToList());
		}


		//FROM Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Passenger)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Driver && oldAd.NumberOfSeats >= newAd.NumberOfSeats);
			CheckDistanceForNotification(newAd, adList.ToList());
		}

		//FROM Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Passenger && oldAd.NumberOfSeats <= newAd.NumberOfSeats);
			CheckDistanceForNotification(newAd, adList.ToList());
		}


	}





	


	public async Task ValidateAdress()
	{
		(ad.Latitude, ad.Longitude) = await DataService.GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
	}


	public async Task<bool> IsAddressValid(string address)
	{
		if (address == null)
			return false;

		(ad.Latitude, ad.Longitude) = await DataService.GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
		if (ad.Latitude == null)
		{
			return false;
		}
		return true;
	}


	bool popUpForTooClose = false;
	public void ClosePopUpForTooClose()
	{
		popUpForTooClose = false;
	}
	public void ShowPopUpForTooClose()
	{
		popUpForTooClose = true;
	}

	bool popUpForTooFar = false;
	public void ClosePopUpForTooFar()
	{
		popUpForTooFar = false;
	}
	public void ShowPopUpForTooFar()
	{
		popUpForTooFar = true;
	}


	bool popUpForTimeIsInPast = false;
	public void ClosePopUpForTimeIsInPast()
	{
		popUpForTimeIsInPast = false;
	}
	public void ShowPopUpForTimeIsInPast()
	{
		popUpForTimeIsInPast = true;
	}



	async void CheckAd()
	{
		ad.Latitude = await GetLatitude();
		ad.Longitude = await GetLongitude();
		if (ad.Longitude == 0 || ad.Latitude == 0)
		{
			ad.Latitude = latitudeBB;
			ad.Longitude = longitudeBB;
		}
		int distance = await DataService.GetDistance(latitudeBB, longitudeBB, ad.Latitude, ad.Longitude);
		if (ad.PickUpDateAndTime <= DateTime.Now)
		{
			ShowPopUpForTimeIsInPast();
			StateHasChanged();
		}
		else if (await DataService.IsItTooCloseToBB(distance))
		{
			ShowPopUpForTooClose();
			StateHasChanged();
		}
		else if (await DataService.IsItTooFarFromBB(distance))
		{
			ShowPopUpForTooFar();
			StateHasChanged();
		}
		else
		{
			WriteData();
		}
	}

	async Task WriteData()
	{
		context.Ads.Add(ad);
		if (ad.SpecificRequests is null)
		{
			ad.SpecificRequests = "No Specific requests";
		}
		context.SaveChanges();
		SendNotificationAboutAd(ad);
		NavigationManager.NavigateTo("Ads");
	}


	



	



}
