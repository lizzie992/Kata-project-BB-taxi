					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">Are you already in Baierbrunn?</h3>
								<button type="button" class="close" @onclick="ClosePopUpForTooClose"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>Looks like your ad is very close to Baierbrunn.</p>
								<button type="button" class="close" @onclick="ClosePopUpForTooClose">Go back to edit the location!</button>
							</div>
						</div>
					</div>
				</div>
			}

			@if (popUpForTooFar)
			{
				<div class="modal" tabindex="-1" style="display:block" role="dialog">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">Are you trying to reach Baierbrunn from the moon?</h3>
								<button type="button" class="close" @onclick="ClosePopUpForTooFar"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>Looks like your ad is very far away from Baierbrunn.</p>
								<button type="button" class="close" @onclick="ClosePopUpForTooFar">Go back to edit the location!</button>
							</div>
						</div>
					</div>
				</div>
			}

			@if (popUpForTimeIsInPast)
			{
				<div class="modal" tabindex="-1" style="display:block" role="dialog">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">Your pick up time is in the past!</h3>
								<button type="button" class="close" @onclick="ClosePopUpForTimeIsInPast"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>The pick up time you added is in the past! Please go back and correct it</p>
								<button type="button" class="close" @onclick="ClosePopUpForTimeIsInPast">I will correct it!</button>
							</div>
						</div>
