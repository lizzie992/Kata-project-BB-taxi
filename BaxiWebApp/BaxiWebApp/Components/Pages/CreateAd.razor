@page "/CreateAd"
@using BB
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Net.Mail
@using System.Net
@using System.IO
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request;
@using GoogleMapsApi.Entities.Directions.Response;
@using GoogleMapsApi.Entities.Geocoding.Request;
@using GoogleMapsApi.Entities.Geocoding.Response;
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService

<AuthorizeView Context="authContext">
	<Authorized>

		@if (currentlyLoggedInUser.isActive == false)
		{
			<p style="text-align:center; font-size:150%;">You are inactivated, this page is not available for you</p>
		}
		else
		{

			<PageTitle>Create A New Ad</PageTitle>

			<EditForm Model="@ad">
				I am a: <br>
				<InputSelect @bind-Value="ad.AdType" id="adType">
					@foreach (var value in Enum.GetValues<AdType>())
					{
						if (value == AdType.SelectAll)
						{
							continue;
						}
						<option value="@value">@value.ToString()</option>
					}
				</InputSelect>
				<br>

				Direction: <br>
				<InputSelect @bind-Value="ad.AdDirection" id="adDirection">
					@foreach (var value in Enum.GetValues<AdDirection>())
					{
						if (value == AdDirection.SelectAll)
						{
							continue;
						}
						<option value="@value">@value.ToString()</option>
					}
				</InputSelect>
				<br>


				Pick up / drop off location (outside of Baierbrunn) <br>
				<InputText @bind-Value="ad.PickUpDropOffLocation"></InputText><br>
				<br>

				Pick up date: <br>
				<InputDate Type="InputDateType.DateTimeLocal"
				min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="ad.PickUpDateAndTime">
				</InputDate>
				<br>

				Number of seats: <br>
				<InputSelect @bind-Value="ad.NumberOfSeats" id="numberOfSeats">
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
				</InputSelect>
				<br>

				Specific requests: <br>
				<InputText @bind-Value="ad.SpecificRequests"></InputText><br>
				<br>

				<button class="btn btn-primary" @onclick="WriteData">Save</button>
				<br>

			</EditForm>
		}

	</Authorized>
</AuthorizeView>

@code {

	private static Ad ad { get; set; } = new();

	private string anything = string.Empty;




	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		ad = new Ad();
		ad.AdOwner = currentlyLoggedInUser;
		ad.AdType = CreateAd.ad.AdType;
		ad.AdDirection = CreateAd.ad.AdDirection;
		ad.PickUpDropOffLocation = CreateAd.ad.PickUpDropOffLocation;
		ad.PickUpDateAndTime = DateTime.Today;
		ad.PickUpDateAndTime = CreateAd.ad.PickUpDateAndTime;
		ad.NumberOfSeats = CreateAd.ad.NumberOfSeats;
		ad.SpecificRequests = CreateAd.ad.SpecificRequests;

		base.OnParametersSet();
	}

	private User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	public void sendEmailAboutRoute(Ad ad)
	{
		DataService.sendEmailNewAd(ad);
	}



	async Task WriteData()
	{
		context.Ads.Add(ad);
		context.SaveChanges();
		sendEmailAboutRoute(ad);
		NavigationManager.NavigateTo("Ads");
	}





	



}
