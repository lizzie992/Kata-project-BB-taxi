								<option value="2">2</option>
								<option value="3">3</option>
								<option value="4">4</option>
								<option value="5">5</option>
								<option value="6">6</option>
							</InputSelect>
							<ValidationMessage For=@(() => ad.NumberOfSeats) />
							<br>
						</div>

						Specific requests: <br>
						<InputText @bind-Value="ad.SpecificRequests"></InputText><br>
						<br>


						<div class="form-group">
							<label for="PickUpDropOffLocation">Pick up / drop off location (outside of Baierbrunn)</label>
							<input @bind="ad.PickUpDropOffLocation" class="form-control" id="PickUpDropOffLocation"
								   @bind:event="oninput" @onkeyup="OnValueChange"></input><br>
							<ValidationMessage For="() => ad.PickUpDropOffLocation" />
							<br>
						</div>

						Save the ad:
						<button class="btn btn-primary" @onclick="CheckAd">Save</button>
						<br>

						@if (ad.Longitude != null)
						{
							@* @if (ad.AdDirection == AdDirection.ToBaierbrunn)
								{
									<p align="center">
										<iframe width="600"
												height="450"
												loading="lazy"
												allowfullscreen
												src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=@ad.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @ad.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&destination=Givaudan,Baierbrunn+Germany
			&avoid=tolls">
										</iframe>
									</p>
								}
								@if (ad.AdDirection == AdDirection.FromBaierbrunn)
								{
									<p align="center">
										<iframe width="600"
												height="450"
												loading="lazy"
												allowfullscreen
												src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=Givaudan,Baierbrunn+Germany
			&destination=@ad.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @ad.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&avoid=tolls">
										</iframe>
									</p>
								} *@

						}
						else
						{
							@* <div>Please enter a valid address!</div> *@
						}

					</EditForm>



				</div>
				<div class="column right">
					<br>
					@if (showMap)
					{
						<div>Here you can specify the exact pick up / drop off location!</div>
						<div>Please move the marker to the place where you can stop with your car / wait for your pick up!</div>
						<br>
						<div id="map">
						</div>
						<script>
							(g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})
