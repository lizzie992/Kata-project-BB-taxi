@page "/CreateAd"
@using BB
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Net.Mail
@using System.Net
@using System.IO
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request
@using GoogleMapsApi.Entities.Directions.Response
@using GoogleMapsApi.Entities.Geocoding.Request
@using GoogleMapsApi.Entities.Geocoding.Response
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Globalization;
@using System.Threading.Tasks;
@* @using GoogleMapsApi.Entities.DistanceMatrix.Request;
@using GoogleMapsApi.Entities.DistanceMatrix.Response; *@
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService

<AuthorizeView Context="authContext">
	<Authorized>

		@if (currentlyLoggedInUser.isActive == false)
		{
			<p style="text-align:center; font-size:150%;">You are inactivated, this page is not available for you</p>
		}
		else
		{
			<style>
				column {
					float: left;
					padding: 10px;
				}

				.left {
					width: 25%;
				}

				.right {
					width: 75%;
				}
			</style>


			<PageTitle>Create A New Ad</PageTitle>

			<div class="row">
				<div class="column left">
					<EditForm Model="@ad">
						I am a: <br>
						<InputSelect @bind-Value="ad.AdType" id="adType">
							@foreach (var value in Enum.GetValues<AdType>())
							{
								if (value == AdType.SelectAll)
								{
									continue;
								}
								<option value="@value">@value.ToString()</option>
							}
						</InputSelect>
						<br>

						Direction: <br>
						<InputSelect @bind-Value="ad.AdDirection" id="adDirection">
							@foreach (var value in Enum.GetValues<AdDirection>())
							{
								if (value == AdDirection.SelectAll)
								{
									continue;
								}
								<option value="@value">@value.ToString()</option>
							}
						</InputSelect>
						<br>

						Pick up date: <br>
						<InputDate Type="InputDateType.DateTimeLocal"
								   min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="ad.PickUpDateAndTime">
						</InputDate>
						<br>

						Number of seats: <br>
						<InputSelect @bind-Value="ad.NumberOfSeats" id="numberOfSeats">
							<option value="1">1</option>
							<option value="2">2</option>
							<option value="3">3</option>
							<option value="4">4</option>
							<option value="5">5</option>
							<option value="6">6</option>
						</InputSelect>
						<br>

						Specific requests: <br>
						<InputText @bind-Value="ad.SpecificRequests"></InputText><br>
						<br>

						Pick up / drop off location (outside of Baierbrunn) <br>
						<InputText @bind-Value="ad.PickUpDropOffLocation"></InputText><br>
						<br>

						Please check if the address is correct, otherwise the ad will not be saved:
						<button class="btn btn-primary" @onclick="ValidateAdress">Check address</button>
						<br>

						@if (ad.Longitude != null)
						{
							@if (ad.AdDirection == AdDirection.ToBaierbrunn)
							{
								<p align="center">
									<iframe width="600"
											height="450"
											loading="lazy"
											allowfullscreen
											src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=@ad.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @ad.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&destination=Givaudan,Baierbrunn+Germany
			&avoid=tolls">
									</iframe>
								</p>
							}
							@if (ad.AdDirection == AdDirection.FromBaierbrunn)
							{
								<p align="center">
									<iframe width="600"
											height="450"
											loading="lazy"
											allowfullscreen
											src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=Givaudan,Baierbrunn+Germany
			&destination=@ad.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @ad.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&avoid=tolls">
									</iframe>
								</p>
							}

							<div>If this is the correct route, please, save the ad:</div>
							<button class="btn btn-primary" @onclick="WriteData">Save</button>
							<br>

						}
						else
						{
							<div>Please enter a valid address!</div>
						}

					</EditForm>
				</div>
			</div>
		}

	</Authorized>
</AuthorizeView>

@code {

	private static Ad ad { get; set; } = new();

	private string anything = string.Empty;



	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		ad = new Ad();
		ad.AdOwner = currentlyLoggedInUser;
		ad.AdType = CreateAd.ad.AdType;
		ad.AdDirection = CreateAd.ad.AdDirection;
		ad.PickUpDropOffLocation = CreateAd.ad.PickUpDropOffLocation;
		ad.PickUpDateAndTime = DateTime.Today;
		ad.PickUpDateAndTime = CreateAd.ad.PickUpDateAndTime;
		ad.NumberOfSeats = CreateAd.ad.NumberOfSeats;
		ad.SpecificRequests = CreateAd.ad.SpecificRequests;
		base.OnParametersSet();
	}

	private User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}



	public void sendNotificationAboutAd(Ad newAd) //newAd is the ad that was just added, the oldAd is the ad that already existed - both will be subject of notifications, so if there is a match, both adowners will be notified
	{
		int distanceLimit = 5000; //this is the limit of how many meters we calculate the notificaions for, PAY ATTENTION METERS, NOT KILOMETERS
		var adList = context.Ads.ToList<Ad>().AsEnumerable();

		//TO Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Passenger)
		{

			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Driver);
			foreach (Ad oldAd in adList)
			{
				int distance = getDistance(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude).Result;
				if (distance <= distanceLimit)
				{
					DataService.sendEmailNewAd(oldAd, newAd.AdOwner.Email);
					DataService.sendEmailNewAd(newAd, oldAd.AdOwner.Email);
				}
			}
		}

		//TO Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.ToBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.ToBaierbrunn && oldAd.AdType == AdType.Passenger);
			foreach (Ad oldAd in adList)
			{
				int distance = getDistance(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude).Result;
				if (distance <= distanceLimit)
				{
					DataService.sendEmailNewAd(oldAd, newAd.AdOwner.Email);
					DataService.sendEmailNewAd(newAd, oldAd.AdOwner.Email);
				}
			}
		}


		//FROM Baierbrunn, passenger looking for drivers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Passenger)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Driver);
			foreach (Ad oldAd in adList)
			{
				int distance = getDistance(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude).Result;
				if (distance <= distanceLimit)
				{
					DataService.sendEmailNewAd(oldAd, newAd.AdOwner.Email);
					DataService.sendEmailNewAd(newAd, oldAd.AdOwner.Email);
				}
			}
		}

		//FROM Baierbrunn, driver looking for passengers
		if (newAd.AdDirection == AdDirection.FromBaierbrunn && newAd.AdType == AdType.Driver)
		{
			adList = adList.Where(oldAd => oldAd.AdDirection == AdDirection.FromBaierbrunn && oldAd.AdType == AdType.Passenger);
			foreach (Ad oldAd in adList)
			{
				int distance = getDistance(newAd.Latitude, newAd.Longitude, oldAd.Latitude, oldAd.Longitude).Result;
				if (distance <= distanceLimit)
				{
					DataService.sendEmailNewAd(oldAd, newAd.AdOwner.Email);
					DataService.sendEmailNewAd(newAd, oldAd.AdOwner.Email);
				}
			}
		}


	}


	public async Task ValidateAdress()
	{
		(ad.Latitude, ad.Longitude) = await GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
	}


	public async Task<bool> isAddressValid(string address)
	{
		if (address == null)
			return false;

		(ad.Latitude, ad.Longitude) = await GetCoordinatesFromAddress(ad.PickUpDropOffLocation);
		if (ad.Latitude == null)
		{
			return false;
		}
		return true;
	}


	async Task WriteData()
	{
		context.Ads.Add(ad);
		context.SaveChanges();
		getDistance(ad.Latitude, ad.Longitude, 48.020562751900634, 11.482608552423985);
		// sendNotificationAboutAd(ad);
		NavigationManager.NavigateTo("Ads");
	}


	/// <summary>
	///
	/// </summary>
	/// <param name="address"></param>
	/// <returns>tuple with lat and long</returns>
	public async Task<(double?, double?)> GetCoordinatesFromAddress(string address)
	{

		var request = new GeocodingRequest
			{
				ApiKey = "AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk",
				Address = address
			};

		var result = await GoogleMaps.Geocode.QueryAsync(request);

		Location location = result.Results.FirstOrDefault()?.Geometry?.Location;

		if (location == null)
		{
			return (null, null);
		}

		string coordinates = $"{location.Latitude}, {location.Longitude}";

		return (location.Latitude, location.Longitude);
	}



	public async Task<int> getDistance(double? coordinate1, double? coordinate2, double? coordinate3, double? coordinate4)
	{
		if (coordinate1 == null || coordinate2 == null || coordinate3 == null || coordinate4 == null)
		{
			return 0;
		}

		var request = new DirectionsRequest { Origin = $"{coordinate1?.ToString("F8", CultureInfo.InvariantCulture)}, {coordinate2?.ToString("F8", CultureInfo.InvariantCulture)}", Destination = $"{coordinate3?.ToString("F8", CultureInfo.InvariantCulture)}, {coordinate4?.ToString("F8", CultureInfo.InvariantCulture)}", TravelMode = TravelMode.Driving };
		request.ApiKey = "AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk";
		var result = await GoogleMaps.Directions.QueryAsync(request);
		var legs = result.Routes.First().Legs;
		int totalDistanceInMeters = legs.Sum(leg => leg.Distance.Value);
		return totalDistanceInMeters;
	}



}
