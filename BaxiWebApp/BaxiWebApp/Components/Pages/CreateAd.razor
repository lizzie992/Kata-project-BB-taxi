					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">Please give me a correct address</h3>
								<button type="button" class="close" @onclick="ClosePopUpForWrongCoordinates"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>Looks like the location you wrote is not corect, please, give me a valid address!</p>
								<button type="button" class="close" @onclick="ClosePopUpForWrongCoordinates">I will correct it!</button>
							</div>
						</div>
					</div>
