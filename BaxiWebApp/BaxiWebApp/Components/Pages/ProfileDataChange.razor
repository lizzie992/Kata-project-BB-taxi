@page "/ProfileDataChange"
@using BB

<PageTitle>ProfileDataChange</PageTitle>

<h1 style="text-align:center;">Change your profile data!</h1>

<EditForm Model="@author" OnValidSubmit="SaveAuthor">
    First name:
    <InputText @bind-Value="firstName"></InputText><br>
    <button class="btn btn-primary" @onclick="SaveFirstName">Save</button><br>
    <br>
    Last name:
    <InputText @bind-Value="lastName"></InputText><br>
    <button class="btn btn-primary" @onclick="SaveLastName">Save</button><br>
    <br>
    Department:
    <InputSelect @bind-Value="department" id="department">
        @foreach (var value in Enum.GetValues<Department>())
        {
            <option value="@value">@value.ToString()</option>
        }
    </InputSelect>
    <button class="btn btn-primary" @onclick="SaveDepartment">Save</button><br>
    <br>
    Preferred language:
    <InputSelect @bind-Value="preferredLanguage" id="preferredLanguage">
        @foreach (var value in Enum.GetValues<PreferredLanguage>())
        {
            <option value="@value">@value.ToString()</option>
        }
    </InputSelect>
    <button class="btn btn-primary" @onclick="SavePreferredLanguage">Save</button><br>
    <br>
    Location:
    <InputText @bind-Value="location"></InputText><br>
    <button class="btn btn-primary" @onclick="SaveLocation">Save</button><br>
    <br>
    Contact:
    <InputText @bind-Value="contact"></InputText><br>
    <button class="btn btn-primary" @onclick="SaveContact">Save</button><br>
    <br>
    <a href="Profile">
        <button>Back to your profile!</button>
    </a>

</EditForm>


@code {
    User user = Profile.user;

    public string firstName { get; set; }

    public string lastName { get; set; }

    public Department department { get; set; }

    public PreferredLanguage preferredLanguage { get; set; }

    public string location { get; set; }

    public string contact { get; set; }



    private void SaveFirstName()
    {
        user.FirstName = firstName;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    private void SaveLastName()
    {
        user.LastName = lastName;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    private void SaveDepartment()
    {
        user.Department = department;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    private void SavePreferredLanguage()
    {
        user.PreferredLanguage = preferredLanguage;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    private void SaveLocation()
    {
        user.Location = location;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    private void SaveContact()
    {
        user.Contact = contact;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

    Author author = new Author();



    private void SaveAuthor()
    {
        Console.WriteLine(author.FirstName);
    }
    public class Author
    {
        public string FirstName { get; set; } = "Kataa";
    }

}
