@page "/ProfileDataChange"
@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject UserManager<User> UserManager;


<AuthorizeView Context="authContext">
    <Authorized>
        <PageTitle>ProfileDataChange</PageTitle>

        <h1 style="text-align:center;">Change your profile data!</h1>


        <EditForm Model="@user" OnValidSubmit="Save">

            First name:
            <InputText @bind-Value="user.FirstName"></InputText><br>
            <br>

            Last name:
            <InputText @bind-Value="user.LastName"></InputText><br>
            <br>

            Department:
            <InputSelect @bind-Value="user.Department" id="department">
                @foreach (var value in Enum.GetValues<Department>())
                {
                    <option value="@value">@value.ToString()</option>
                }
            </InputSelect>
            <br>

            Preferred language:
            <InputSelect @bind-Value="user.PreferredLanguage" id="preferredLanguage">
                @foreach (var value in Enum.GetValues<PreferredLanguage>())
                {
                    <option value="@value">@value.ToString()</option>
                }
            </InputSelect>
            <br>


            Contact:
            <InputText @bind-Value="user.Contact"></InputText><br>
            <br>

            <a href="Profile">
                <button @onclick="Save">Save</button>
            </a>

        </EditForm>
    </Authorized>
</AuthorizeView>

@code {
    public static User user;
    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        user = await UserManager.GetUserAsync(claims);
    }

    protected override void OnParametersSet()
    {
        identifyLoggedInUser();
        base.OnParametersSet();
    }

    private void Save()
    {
        UserManager.UpdateAsync(user);
    }

}
