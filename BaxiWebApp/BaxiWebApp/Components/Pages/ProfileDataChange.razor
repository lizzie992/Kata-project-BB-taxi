@page "/ProfileDataChange"
@using BB

<PageTitle>ProfileDataChange</PageTitle>

<h1 style="text-align:center;">Change your profile data!</h1>

<form>
    <label for="fname">First name:</label><br>
    <input type="text" id="fname" name="fname"><br>

    <label for="lname">Last name:</label><br>
    <input type="text" id="lname" name="lname"><br>

    <label for="department">Department:</label><br>
    <input type="text" id="department" name="department"><br>

    <label for="location">Location:</label><br>
    <input type="text" id="location" name="location"><br>

    <label for="preflang">Preferred language:</label><br>
    <input type="text" id="preflang" name="preflang"><br>

    <label for="contact">Contact:</label><br>
    <input type="text" id="contact" name="contact"><br>
    <br>
    <button>Save</button>

</form>


@code {
    User user = Profile.user;

}
