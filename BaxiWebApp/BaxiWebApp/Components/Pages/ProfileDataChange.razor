@page "/ProfileDataChange"
@using BB

<PageTitle>ProfileDataChange</PageTitle>

<h1 style="text-align:center;">Change your profile data!</h1>

<form>
    First name:
    <InputText @bind-Value="firstName"></InputText><br>
    <button class="btn btn-primary" @onclick="SaveNewName">Save</button><br>




</form>


@code {
    User user = Profile.user;

    [Parameter]
    public string firstName { get; set; }

    private void SaveNewName()
    {
        user.FirstName = firstName;
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

}
