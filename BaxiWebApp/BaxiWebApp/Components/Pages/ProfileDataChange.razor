@page "/ProfileDataChange"
@using BB

<PageTitle>ProfileDataChange</PageTitle>

<h1 style="text-align:center;">Change your profile data!</h1>

<EditForm Model="@user" OnValidSubmit="Save">

    First name:
    <InputText @bind-Value="user.FirstName"></InputText><br>
    <br>

    Last name:
    <InputText @bind-Value="user.LastName"></InputText><br>
    <br>

    Department:
    <InputSelect @bind-Value="user.Department" id="department">
        @foreach (var value in Enum.GetValues<Department>())
        {
            <option value="@value">@value.ToString()</option>
        }
    </InputSelect>
    <br>

    Preferred language:
    <InputSelect @bind-Value="user.PreferredLanguage" id="preferredLanguage">
        @foreach (var value in Enum.GetValues<PreferredLanguage>())
        {
            <option value="@value">@value.ToString()</option>
        }
    </InputSelect>
    <br>

    Location:
    <InputText @bind-Value="user.Location"></InputText><br>
    <br>

    Contact:
    <InputText @bind-Value="user.Contact"></InputText><br>
    <br>

    <button class="btn btn-primary" @onclick="Save">Save</button>
    <br>

    <a href="Profile">
        <button>Back to your profile!</button>
    </a>

</EditForm>


@code {
    private static User user { get; set; } = new();

    protected override void OnParametersSet()
    {
        User user = new User();
        user.EmailAddress = Profile.user.EmailAddress;
        user.FirstName = Profile.user.FirstName;
        user.LastName = Profile.user.LastName;
        user.Department = Profile.user.Department;
        user.Location = Profile.user.Location;
        user.Contact = Profile.user.Contact;
        base.OnParametersSet();
    }

    private void Save()
    {
        user = Profile.user;
        Profile.userList.Add(user);
        BB.LogicalCode.SaveUserToFile(Profile.userList);
    }

}
