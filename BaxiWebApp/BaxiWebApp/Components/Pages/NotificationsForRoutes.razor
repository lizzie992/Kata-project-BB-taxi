@page "/NotificationsForRoutes"
@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject Data.BaxiWebAppContext context;
@inject NavigationManager NavigationManager

<p>Here you can add some keywords! If someone posts an Ad that has the keyword in their route, you will receive an email notification!</p>

@if (user.NotificationForRoute.Count == 0)
{
    <p>You do not have any notifications yet!</p>
}
else
{
    foreach (var item in user.NotificationForRoute)
    {
        <p>Keyword: @_keyword</p>
        <button class="btn btn-primary" @onclick="deleteKeyword">Delete this keyword!</button>
        <br>
    }
}

<br>
Add a new Keyword:
<InputText @bind-Value="_keyword"></InputText>
<button class="btn btn-primary" @onclick="addNewKeyword">Save</button>

@code {

    private User user;
    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        user = await UserManager.GetUserAsync(claims);
    }

    protected override void OnParametersSet()
    {
        identifyLoggedInUser().GetAwaiter().GetResult();
        base.OnParametersSet();
    }


    private string _keyword;
    public void addNewKeyword()
    {
        user.NotificationForRoute.Add(_keyword);
        context.SaveChanges();
    }


    public void deleteKeyword()
    {
        user.NotificationForRoute.Remove(_keyword);
        context.SaveChanges();
    }



}
