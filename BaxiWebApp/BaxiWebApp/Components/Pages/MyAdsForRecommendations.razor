@page "/MyAdsForRecommendations"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using System.Globalization;


<AuthorizeView Context="authContext">
	<Authorized>
		<header>
			<link rel="stylesheet" href="styles.css" />
		</header>

		<body>

			@if (FilteredAds.ToArray().Length == 0)
			{
				<div style="text-align:center">@localizer["You_do_not_have_any_ads_you_can_create_ads_by_clicking_on_Create_Ad_in_the_menu"]</div>
			}
			else
			{
				<h3 style="text-align:center">@localizer["Below_you_can_select_one_of_your_ads_and_find_matches"]</h3>
				<div class="grid-wrapper">
					<QuickGrid Items="FilteredAds" @ref="grid">
						<PropertyColumn Title="@localizer["Ad_type"]" Property="@(Ad => @localizer[@Ad.AdType.ToString()])" >
						</PropertyColumn>
						<PropertyColumn Title="@localizer["Ad_direction"]" Property="@(Ad => @localizer[@Ad.AdDirection.ToString()])" >
						</PropertyColumn>
						<PropertyColumn Title="@localizer["From/to_this_address"]" Property="@(Ad => Ad.PickUpDropOffLocation)" >
						</PropertyColumn>
						<PropertyColumn Title="@localizer["Pick_up_date_and_time"]" Property="@(Ad => Ad.PickUpDateAndTime.ToString("g"))"  />
						<PropertyColumn Title="@localizer["Number_of_seats"]" Property="@(Ad => Ad.NumberOfSeats)"  />
						<PropertyColumn Title="@localizer["Specific_requests"]" Property="@(Ad => Ad.SpecificRequests)"  />
						<TemplateColumn Title="@localizer["Find_me_ads_that_would_match_this_ad"]" Context="Ad">
							@if (Ad.PickUpDateAndTime >= DateTime.Now)
							{
								<button @onclick="() => recommendAds(Ad)">@localizer["Find_me_recommendations"]</button>
							}
							else
							{
								<p>@localizer["This_ad_is_in_the_past"]</p>
							}
						</TemplateColumn>
					</QuickGrid>
				</div>
				<div class="card-container-for-grid">
					@foreach (Ad ad in FilteredAds)
					{
						<div class="card">
							<table>
								<tr>
									<th style="text-align: left">@localizer["Ad_type"]</th>
									<th style="text-align: right">@localizer[@ad.AdType.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Ad_owner"]</th>
									<th style="text-align: right">@DataService.showUserNameWithStatus(ad.AdOwner)</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Ad_direction"]</th>
									<th style="text-align: right">@localizer[ad.AdDirection.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["From/to_this_address"]</th>
									<th style="text-align: right">@ad.PickUpDropOffLocation</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
									<th style="text-align: right">@ad.PickUpDateAndTime.ToString("g")</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Number_of_seats"]</th>
									<th style="text-align: right">@ad.NumberOfSeats</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Specific_requests"]</th>
									<th style="text-align: right">@ad.SpecificRequests</th>
								</tr>
							</table>
							@if (ad.PickUpDateAndTime >= DateTime.Now)
							{
								<button @onclick="() => recommendAds(ad)">@localizer["Find_me_recommendations"]</button>
							}
							else
							{
								<p style="text-align: center">@localizer["This_ad_is_in_the_past"]</p>
							}
						</div>
					}
				</div>
			}
		</body>
	</Authorized>
</AuthorizeView>


@code {

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(user);
		}
	}

	public User user;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		user = await UserManager.GetUserAsync(claims);
	}


	public static List<Ad> AdList = new List<Ad>();
	protected override void OnParametersSet()
	{
		identifyLoggedInUser();
		AdList = context.Ads.ToList<Ad>();
		base.OnParametersSet();
	}

	QuickGrid<Ad>? grid;
	IQueryable<Ad> FilteredAds
	{
		get
		{
			var result = context.Ads.ToList<Ad>().AsQueryable();
			result = result.Where(Ad => Ad.AdOwner == user);
			return result;
		}
	}

	private int ID;
	/// <summary>
	/// Redirects the user to the RecommendedAds page with the correct ID number
	/// </summary>
	/// <param name="ad">Ad</param>
	public void recommendAds(Ad ad)
	{
		ID = ad.ID;
		NavigationManager.NavigateTo("RecommendedAds/" + ID);
	}
}
