@page "/MyAdsForRecommendations"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using System.Globalization;
@using BaxiWebApp.Data
@inject IDbContextFactory<BaxiWebAppContext> DbContextFactory
@using Microsoft.EntityFrameworkCore

<PageTitle>@localizer["My_ads"]</PageTitle>

<AuthorizeView Context="authContext">
	<Authorized>

		<body>

			@if (FilteredAds.ToArray().Length == 0)
			{
				<div style="text-align:center">@localizer["You_do_not_have_any_ads_you_can_create_ads_by_clicking_on_Create_Ad_in_the_menu"]</div>
			}
			else
			{
				<h3 style="text-align:center">@localizer["Below_you_can_select_one_of_your_ads_and_find_matches"]</h3>
				<div class="grid-wrapper">
					<QuickGrid Items="FilteredAds" @ref="grid">
						<PropertyColumn Title="@localizer["Ad_type"]" Property="@(Ad => @localizer[@Ad.AdType.ToString()])">
						</PropertyColumn>
						<PropertyColumn Title="@localizer["Ad_direction"]" Property="@(Ad => @localizer[@Ad.AdDirection.ToString()])">
						</PropertyColumn>
						<PropertyColumn Title="@localizer["From/to_this_address"]" Property="@(Ad => Ad.PickUpDropOffLocation)">
						</PropertyColumn>
						<PropertyColumn Title="@localizer["Frequency"]" Property="@(Ad => @localizer[@Ad.AdFrequency.ToString()])">
						</PropertyColumn>
						<TemplateColumn Title="@localizer["Pick_up_date_and_time"]" Context="Ad">
							@if (Ad.AdFrequency == AdFrequency.OneTime)
							{
								@Ad.PickUpDateAndTime
							}
							@if (Ad.AdFrequency == AdFrequency.Recurring)
							{
								@if (Ad.PickUpDay.Contains(DayOfWeek.Monday))
								{
									<p>
										@localizer["Every_Monday_at"]
										@DataService.showTimeWithoutDate(Ad.PickUpTimeMonday)
									</p>
								}
								@if (Ad.PickUpDay.Contains(DayOfWeek.Tuesday))
								{
									<p>
										@localizer["Every_Tuesday_at"]
										@DataService.showTimeWithoutDate(Ad.PickUpTimeTuesday)
									</p>

								}
								@if (Ad.PickUpDay.Contains(DayOfWeek.Wednesday))
								{
									<p>
										@localizer["Every_Wednesday_at"]
										@DataService.showTimeWithoutDate(Ad.PickUpTimeWednesday)
									</p>

								}
								@if (Ad.PickUpDay.Contains(DayOfWeek.Thursday))
								{
									<p>
										@localizer["Every_Thursday_at"]
										@DataService.showTimeWithoutDate(Ad.PickUpTimeThursday)
									</p>

								}
								@if (Ad.PickUpDay.Contains(DayOfWeek.Friday))
								{
									<p>
										@localizer["Every_Friday_at"]
										@DataService.showTimeWithoutDate(Ad.PickUpTimeFriday)
									</p>

								}
							}
						</TemplateColumn>
						<PropertyColumn Title="@localizer["Number_of_seats"]" Property="@(Ad => Ad.NumberOfSeats)" />
						<PropertyColumn Title="@localizer["Specific_requests"]" Property="@(Ad => Ad.SpecificRequests)" />
						<TemplateColumn Title="@localizer["Find_me_ads_that_would_match_this_ad"]" Context="Ad">
							@if (Ad.AdFrequency == AdFrequency.Recurring || (Ad.AdFrequency == AdFrequency.OneTime && Ad.PickUpDateAndTime >= DateTime.Now))
							{
								<button @onclick="() => recommendAds(Ad)">@localizer["Find_me_recommendations"]</button>
							}
							else
							{
								<p>@localizer["This_ad_is_in_the_past"]</p>
							}
						</TemplateColumn>
					</QuickGrid>
				</div>
				<div class="card-container-for-grid">
					@foreach (Ad ad in FilteredAds)
					{
						<div class="card">
							<table>
								<tr>
									<th style="text-align: left">@localizer["Ad_type"]</th>
									<th style="text-align: right">@localizer[@ad.AdType.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Frequency"]</th>
									<th style="text-align: right">@localizer[@ad.AdFrequency.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Ad_owner"]</th>
									<th style="text-align: right">@DataService.showUserNameWithStatus(ad.AdOwner)</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Ad_direction"]</th>
									<th style="text-align: right">@localizer[ad.AdDirection.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["From/to_this_address"]</th>
									<th style="text-align: right">@ad.PickUpDropOffLocation</th>
								</tr>
								@if (ad.AdFrequency == AdFrequency.OneTime)
								{
									<tr>
										<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
										<th style="text-align: right">@ad.PickUpDateAndTime.ToString("g")</th>
									</tr>
								}
								@if (ad.AdFrequency == AdFrequency.Recurring)
								{
									@if (ad.PickUpDay.Contains(DayOfWeek.Monday))
									{
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@localizer["Every_Monday_at"]@DataService.showTimeWithoutDate(ad.PickUpTimeMonday)</th>
										</tr>
									}
									@if (ad.PickUpDay.Contains(DayOfWeek.Tuesday))
									{
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@localizer["Every_Tuesday_at"]@DataService.showTimeWithoutDate(ad.PickUpTimeTuesday)</th>
										</tr>
									}
									@if (ad.PickUpDay.Contains(DayOfWeek.Wednesday))
									{
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@localizer["Every_Wednesday_at"]@DataService.showTimeWithoutDate(ad.PickUpTimeWednesday)</th>
										</tr>
									}
									@if (ad.PickUpDay.Contains(DayOfWeek.Thursday))
									{
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@localizer["Every_Thursday_at"]@DataService.showTimeWithoutDate(ad.PickUpTimeThursday)</th>
										</tr>
									}
									@if (ad.PickUpDay.Contains(DayOfWeek.Friday))
									{
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@localizer["Every_Friday_at"]@DataService.showTimeWithoutDate(ad.PickUpTimeFriday)</th>
										</tr>
									}
								}
								<tr>
									<th style="text-align: left">@localizer["Number_of_seats"]</th>
									<th style="text-align: right">@ad.NumberOfSeats</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Specific_requests"]</th>
									<th style="text-align: right">@ad.SpecificRequests</th>
								</tr>
							</table>
							@if (ad.AdFrequency == AdFrequency.Recurring || (ad.AdFrequency == AdFrequency.OneTime && ad.PickUpDateAndTime >= DateTime.Now))
							{
								<button @onclick="() => recommendAds(ad)">@localizer["Find_me_recommendations"]</button>
							}
							else
							{
								<p style="text-align: center">@localizer["This_ad_is_in_the_past"]</p>
							}
						</div>
					}
				</div>
			}
		</body>
	</Authorized>
</AuthorizeView>


@code {

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object? sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}




	[CascadingParameter(Name = "currentlyLoggedInUser")]
	private User? user { get; set; }



	private IQueryable<Ad> FilteredAds;
	protected override void OnParametersSet()
	{
		DataService.loadCulture(user);
		using (var context = DbContextFactory.CreateDbContext())
		{
			FilteredAds = context.Ads.Include(ad => ad.AdOwner).ToList<Ad>().Where(Ad => Ad.AdOwner.Id == user.Id).AsQueryable();
		}
		base.OnParametersSet();
	}


	protected override bool ShouldRender()
	{
		DataService.loadCulture(user);
		return base.ShouldRender();
	}


	QuickGrid<Ad>? grid;


	private int ID;
	/// <summary>
	/// Redirects the user to the RecommendedAds page with the correct ID number
	/// </summary>
	/// <param name="ad">Ad</param>
	public void recommendAds(Ad ad)
	{
		ID = ad.ID;
		NavigationManager.NavigateTo("RecommendedAds/" + ID);
	}
}
