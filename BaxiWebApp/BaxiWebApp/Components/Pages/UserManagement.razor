@page "/UserManagement"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.QuickGrid.EntityFrameworkAdapter
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using System.Globalization;
@using Pages.Res;
@inject AuthenticationStateProvider AuthStateProvider;
@inject UserManager<User> UserManager;
@inject Data.BaxiWebAppContext context;
@inject Data.DataService DataService





<AuthorizeView Roles="Admin" Context="authContext">

	<body>
		<h3 style="text-align:center">@localizer["User_management_page"]</h3>

		<div class="row">

			<p style="text-align:center">@localizer["Show_me_the_following_users"]</p>

			<div class="col-12 col-md-6">
				<div class="div-block-centered">
					<div class="input-block">
						<p>@localizer["Role"]</p>
						<InputSelect class="input" @bind-Value="_role" id="_role">
							<option value="allRoles">@localizer["SelectAll"]</option>
							@foreach (var value in context.Roles)
							{
								<option value="@value">@localizer[@value.ToString()]</option>
							}
						</InputSelect>
					</div>
					<div class="input-block">
						<p>@localizer["Status"]</p>
						<InputSelect class="input" @bind-Value="_status" id="_status">
							<option value="All!">@localizer["SelectAll"]</option>
							<option value="Active">@localizer["Active"]</option>
							<option value="Inactive">@localizer["Inactive"]</option>
						</InputSelect>
					</div>

					<div class="input-block">
						<p>@localizer["Email_address_contains"]</p>
						<input type="search" class="input" autofocus @bind="_searchEmail" @bind:event="oninput" placeholder=@localizer["Email"] />
					</div>

					<div class="input-block">
						<p>@localizer["First_name"]</p>
						<input type="search" class="input" autofocus @bind="_searchFirstName" @bind:event="oninput" placeholder=@localizer["First_name"] />
					</div>


					<div class="input-block">
						<p>@localizer["Last_name"]</p>
						<input type="search" class="input" autofocus @bind="_searchLastName" @bind:event="oninput" placeholder=@localizer["Last_name"] />
					</div>
				</div>
			</div>

			<div class="col-12 col-md-6">
				<div class="div-block-centered">
					<div class="input-block">
						<p>@localizer["Contact"]</p>
						<input type="search" class="input" autofocus @bind="_contact" @bind:event="oninput" placeholder=@localizer["Contact"] />
					</div>

					<div class="input-block">
						<p>@localizer["Department"]</p>
						<InputSelect class="input" @bind-Value="_department" id="_department">
							@foreach (var value in Enum.GetValues<Department>())
							{
								<option value="@value">@localizer[@value.ToString()]</option>
							}
						</InputSelect>
					</div>

					<div class="input-block">
						<p>@localizer["Preferred_language"]</p>
						<InputSelect class="input" @bind-Value="_preferredLanguage" id="_preferredLanguage">
							@foreach (var value in Enum.GetValues<PreferredLanguage>())
							{
								<option value="@value">@localizer[@value.ToString()]</option>
							}
						</InputSelect>
					</div>

					@* <div class="input-block">
						<p>@localizer["Rating"]</p>
						<InputSelect class="input" @bind-Value="_rating" id="_rating">
							<option value="-1">@localizer["SelectAll"]</option>
							<option value="0">@localizer["No_rating_yet"]</option>
							<option value="1">1</option>
							<option value="2">2</option>
							<option value="3">3</option>
							<option value="4">4</option>
							<option value="5">5</option>
						</InputSelect>
					</div> *@

					<div class="input-block">
						<p>@localizer["Number_of_warnings"]</p>
						<InputSelect class="input" @bind-Value="_numberOfWarnings" id="_numberOfWarnings">
							<option value="-1">@localizer["SelectAll"]</option>
							<option value="0">@localizer["No_warning_yet"]</option>
							<option value="1">1</option>
							<option value="2">2</option>
						</InputSelect>
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col">
				<div class="grid-wrapper">
					<div class="div-block">
						<QuickGrid Items="UserList" @ref="grid">
							<PropertyColumn Title=@localizer["Role"] Property="@(User => localizer[getRole(User).ToString()])">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Status"] Property="@(User => localizer[getStatus(User)])">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Email_address"] Property="@(User => User.Email)">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["First_name"] Property="@(User => User.FirstName)">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Last_name"] Property="@(User => User.LastName)">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Department"] Property="@(User => localizer[@User.Department.ToString()])">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Preferred_language"] Property="@(User => localizer[@User.PreferredLanguage.ToString()])">
							</PropertyColumn>
							@* <PropertyColumn Title=@localizer["Rating"] Property="@(User => User.Rating)">
							</PropertyColumn> *@
							<PropertyColumn Title=@localizer["Number_of_warnings"] Property="@(User => User.NumberOfWarnings)">
							</PropertyColumn>
							<PropertyColumn Title=@localizer["Contact"] Property="@(User => User.Contact)">
							</PropertyColumn>
							<TemplateColumn Title=@localizer["Make_user_an_admin"] Context="User">
								@if (User.isActive == true && UserManager.GetRolesAsync(User).Result.First() == "Regular")
								{
									<button @onclick="() => showPopUpForMakeUserAdmin(User)">@localizer["Give_this_user_admin_rights"]</button>
								}
							</TemplateColumn>
							<TemplateColumn Title=@localizer["Warning"] Context="User">
								@if (User.isActive == true)
								{
									<button @onclick="() => showPopUpForWarning(User)">@localizer["Give_a_warning"]</button>
								}
							</TemplateColumn>
							<TemplateColumn Title=@localizer["Change_status"] Context="User">
								@if (User.isActive == true)
								{
									<button @onclick="() => showPopUpForDeactivatingUser(User)">@localizer["Deactivate_user"]</button>
								}
								@if (User.isActive == false)
								{
									<button @onclick="() => showPopUpForReactivatingUser(User)">@localizer["Reactivate_user"]</button>
								}
							</TemplateColumn>
						</QuickGrid>
					</div>
				</div>
				<div class="card-container-for-grid">
					@foreach (User user in UserList)
					{
						<div class="card">
							<table>
								<tr>
									<th style="text-align: left">@localizer["Role"]</th>
									<th style="text-align: right">@localizer[getRole(user).ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Status"]</th>
									<th style="text-align: right">@localizer[getStatus(user)]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Email_address"]</th>
									<th style="text-align: right">@user.Email</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["First_name"]</th>
									<th style="text-align: right">@user.FirstName</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Last_name"]</th>
									<th style="text-align: right">@user.LastName</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Department"]</th>
									<th style="text-align: right">@localizer[@user.Department.ToString()]</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Preferred_language"]</th>
									<th style="text-align: right">@localizer[@user.PreferredLanguage.ToString()]</th>
								</tr>
@* 								<tr>
									<th style="text-align: left">@localizer["Rating"]</th>
									<th style="text-align: right">@user.Rating</th>
								</tr> *@
								<tr>
									<th style="text-align: left">@localizer["Number_of_warnings"]</th>
									<th style="text-align: right">@user.NumberOfWarnings</th>
								</tr>
								<tr>
									<th style="text-align: left">@localizer["Contact"]</th>
									<th style="text-align: right">@user.Contact</th>
								</tr>
							</table>
							@if (user.isActive == true && UserManager.GetRolesAsync(user).Result.First() == "Regular")
							{
								<button @onclick="() => showPopUpForMakeUserAdmin(user)">@localizer["Give_this_user_admin_rights"]</button>
							}
							@if (user.isActive == true)
							{
								<button @onclick="() => showPopUpForWarning(user)">@localizer["Give_a_warning"]</button>
							}
							@if (user.isActive == true)
							{
								<button @onclick="() => showPopUpForDeactivatingUser(user)">@localizer["Deactivate_user"]</button>
							}
							@if (user.isActive == false)
							{
								<button @onclick="() => showPopUpForReactivatingUser(user)">@localizer["Reactivate_user"]</button>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</body>

	@if (popUpForWarning)
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">@localizer["Warning"]</h3>
						<button type="button" class="close" @onclick="closePopUpForWarning"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Please_write_here_the_reason_for_the_warning"]</p>
						<InputText @bind-Value="reasonForWarning"></InputText>
						<br>
						<button type="button" class="close" @onclick="() => giveUserAWarning(selectedUser, reasonForWarning)">@localizer["Give_a_warning"]</button>
					</div>
				</div>
			</div>
		</div>


	}



	@if (popUpForMakeUserAdmin)
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">@localizer["Make_user_an_admin"]</h3>
						<button type="button" class="close" @onclick="closePopUpForMakeUserAdmin"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Are_you_sure_you_want_to_make_this_user_an_admin_it_cannot_be_revoked_anymore"]</p>
						<br>
						<button type="button" class="close" @onclick="() => makeUserAdmin(selectedUser)">@localizer["Give_this_user_admin_rights"]</button>
					</div>
				</div>
			</div>
		</div>

	}

	@if (popUpForDeactivatingUser)
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">@localizer["Deactivate_user"]</h3>
						<button type="button" class="close" @onclick="closePopUpForDeactivatingUser"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Please_write_here_the_reason_for_the_deactivation"]</p>
						<InputText @bind-Value="reasonForDeactivating"></InputText>
						<button type="button" class="close" @onclick="() => deactivateUser(selectedUser, reasonForDeactivating)">@localizer["Deactivate_user"]</button>
					</div>
				</div>
			</div>
		</div>

	}

	@if (popUpForReactivatingUser)
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">@localizer["Reactivate_user"]</h3>
						<button type="button" class="close" @onclick="closePopUpForReactivatingUser"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Are_you_sure_you_want_to_reactivate_this_user"]</p>
						<br>
						<button type="button" class="close" @onclick="() => reactivateUser(selectedUser)">@localizer["Reactivate_user"]</button>
					</div>
				</div>
			</div>
		</div>

	}

</AuthorizeView>





@code {

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	BB.UserType _userType = UserType.SelectAll;
	string _searchEmail = "";
	string _searchFirstName = "";
	string _searchLastName = "";
	BB.Department _department = Department.SelectAll;
	BB.PreferredLanguage _preferredLanguage = PreferredLanguage.SelectAll;
	string _location = "";
	int _rating = -1;
	int _numberOfWarnings = -1;
	string _contact = "";
	string _role = "allRoles";
	string _status = "All!";

	string reasonForWarning = "";
	string reasonForDeactivating = "";
	User selectedUser;

	protected override void OnParametersSet()
	{
		identifyLoggedInUser();
		base.OnParametersSet();
	}

	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
	}

	QuickGrid<User>? grid;

	IQueryable<User> UserList
	{
		get
		{
			var result = UserManager.Users.ToList<User>().AsQueryable();

			result = result.Where(User => User.isDeleted == false);

			result = result.Where(User => User.Email.Contains(_searchEmail, StringComparison.CurrentCultureIgnoreCase) &&
			User.FirstName.Contains(_searchFirstName, StringComparison.CurrentCultureIgnoreCase) &&
			User.LastName.Contains(_searchLastName, StringComparison.CurrentCultureIgnoreCase) &&
			User.Contact.Contains(_contact, StringComparison.CurrentCultureIgnoreCase));

			if (_role != "allRoles")
			{
				result = result.Where(User => _role == getRole(User));
			}

			if (_status != "All")
			{
				if (_status == "Active")
				{
					result = result.Where(User => User.isActive == true);
				}
				if (_status == "Inactive")
				{
					result = result.Where(User => User.isActive == false);
				}
			}


			if (_rating != -1)
			{
				result = result.Where(User => User.Rating == _rating);
			}

			if (_numberOfWarnings != -1)
			{
				result = result.Where(User => User.NumberOfWarnings == _numberOfWarnings);
			}

			if (_department != Department.SelectAll)
			{
				result = result.Where(User => User.Department == _department);
			}

			if (_preferredLanguage != PreferredLanguage.SelectAll)
			{
				result = result.Where(User => User.PreferredLanguage == _preferredLanguage);
			}

			return result;
		}
	}


	/// <summary>
	/// Triggers the database method to increase the number of warnings for selected user
	/// </summary>
	/// <param name="user">User</param>
	/// <param name="reasonForWarning">String</param>
	public void giveUserAWarning(User user, string reasonForWarning)
	{
		user.NumberOfWarnings++;
		context.Update(user);
		context.SaveChanges();
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["You_received_a_warning_on_the_baxi_app"];
		string text = localizer["Dear_{0}_you_have_received_a_warning_from_one_of_our_admins_reason_for_the_warning_is_{1}_your_current_number_of_warnings_is_{2}_please_be_aware_that_as_soon_as_you_reach_{3}_warnings_your_account_will_be_automatically_inactivated", DataService.showUserNameWithStatus(user), reasonForWarning, user.NumberOfWarnings, Constants.MAX_NUMBER_OF_WARNINGS];
		DataService.sendEmail(emailAddress, subject, text);
		if (user.NumberOfWarnings == Constants.MAX_NUMBER_OF_WARNINGS)
		{
			string reason = localizer["You_have_reached_3_warnings"];
			deactivateUser(user, reason);
			context.SaveChanges();
		}
		reasonForWarning = "";
		closePopUpForWarning();
		grid.RefreshDataAsync();
	}

	/// <summary>
	/// Triggers the database method to deactivate selected user
	/// </summary>
	/// <param name="user">User</param>
	/// <param name="reasonForDeactivating">String</param>
	public void deactivateUser(User user, string reasonForDeactivating)
	{
		user.isActive = false;
		context.Update(user);
		context.SaveChanges();
		string text = localizer["Dear_{0}_your_account_has_been_deactivated_the_reason_is_{1}_please_contact_the_admin_team_about_the_possible_reactivation", DataService.showUserNameWithStatus(user), reasonForDeactivating];
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["Your_baxi_account_has_been_deactivated"];
		DataService.sendEmail(emailAddress, subject, text);
		closePopUpForDeactivatingUser();
		grid.RefreshDataAsync();
	}

	/// <summary>
	/// Triggers the database method to reactivate selected user
	/// </sumMAX_NUMBER_OF_WARNINGSname="user">User</param>
	public void reactivateUser(User user)
	{
		user.isActive = true;
		user.NumberOfWarnings = 0;
		context.Update(user);
		context.SaveChanges();
		string text = localizer["Dear_{0}_your_account_has_been_reactivated_you_can_now_use_all_functions_again", DataService.showUserNameWithStatus(user)];
		string subject = localizer["Your_baxi_account_has_been_reactivated"];
		string emailAddress = "gulyaskata99@gmail.com";
		DataService.sendEmail(emailAddress, subject, text);
		closePopUpForReactivatingUser();
		grid.RefreshDataAsync();
	}

	/// <summary>
	/// Changes the user's role to Admin
	/// </summary>
	/// <param name="user">User</param>
	public void makeUserAdmin(User user)
	{
		if (UserManager.GetRolesAsync(user).Result.First() == "Regular")
		{
			UserManager.RemoveFromRoleAsync(user, "Regular");
			UserManager.AddToRoleAsync(user, "Admin");
			context.SaveChanges();
			closePopUpForMakeUserAdmin();
			grid.RefreshDataAsync();
		}
	}

	public User currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();
		var claims = authState.User;
		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	/// <summary>
	/// Finds the role of the selected user (Regular or Admin)
	/// </summary>
	/// <param name="user">User</param>
	/// <returns>Regular or Admin</returns>
	public string getRole(User user)
	{
		var list = UserManager.GetRolesAsync(user).Result;
		return list.First();
	}

	/// <summary>
	/// Checks the status of the given user (Active or Inactive)
	/// </summary>
	/// <param name="user">User</param>
	/// <returns>Active or Inactive</returns>
	public string getStatus(User user)
	{
		string status = "";
		if (user.isActive == true)
		{
			status = "Active";
		}
		if (user.isActive == false)
		{
			status = "Inactive";
		}
		return status;
	}




	bool popUpForWarning = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about giving a warning to a user
	/// </summary>
	public void closePopUpForWarning()
	{
		reasonForWarning = "";
		popUpForWarning = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about giving a warning to a user
	/// </summary>
	/// <param name="user">User</param>
	public void showPopUpForWarning(User user)
	{
		selectedUser = user;
		popUpForWarning = true;
	}




	bool popUpForMakeUserAdmin = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about making a selected user an admin
	/// </summary>
	public void closePopUpForMakeUserAdmin()
	{
		popUpForMakeUserAdmin = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about making a selected user an admin
	/// </summary>
	/// <param name="user">User</param>
	public void showPopUpForMakeUserAdmin(User user)
	{
		selectedUser = user;
		popUpForMakeUserAdmin = true;
	}



	bool popUpForDeactivatingUser = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about deacticvating a selected user
	/// </summary>
	public void closePopUpForDeactivatingUser()
	{
		popUpForDeactivatingUser = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about deacticvating a selected user
	/// </summary>
	/// <param name="user">User</param>
	public void showPopUpForDeactivatingUser(User user)
	{
		selectedUser = user;
		popUpForDeactivatingUser = true;
	}


	bool popUpForReactivatingUser = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about reacticvating a selected user
	/// </summary>
	public void closePopUpForReactivatingUser()
	{
		popUpForReactivatingUser = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about reacticvating a selected user
	/// </summary>
	/// <param name="user">User</param>
	public void showPopUpForReactivatingUser(User user)
	{
		selectedUser = user;
		popUpForReactivatingUser = true;
	}
}
