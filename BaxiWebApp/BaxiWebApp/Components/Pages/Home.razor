@code {

	private void OnSelected(ChangeEventArgs e)
	{
		var selectedCulture = e.Value.ToString();
		CultureInfo.CurrentCulture = CultureInfo.GetCultures(CultureTypes.AllCultures)
						.First(c => c.Name == selectedCulture);
		StateHasChanged();
	}

	public static User? user;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		user = await UserManager.GetUserAsync(claims);

	}


}


