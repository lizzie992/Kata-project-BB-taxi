@page "/"
@using BB
@using Microsoft.AspNetCore.Identity
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request;
@using GoogleMapsApi.Entities.Directions.Response;
@using GoogleMapsApi.Entities.Geocoding.Request;
@using GoogleMapsApi.Entities.Geocoding.Response;
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using Pages.Res;
@using Microsoft.EntityFrameworkCore;
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<Resources> localizer
@inject AuthenticationStateProvider AuthStateProvider;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService
@inject Data.BaxiWebAppContext context;


<body>
	<PageTitle>Home</PageTitle>
	<h1 style="text-align:center">@localizer["Welcome_to_Baierbrunn"]</h1>

	<img src="https://www.bayregio.de/baierbrunn/oben.jpg" alt="Beautiful Baierbrunn">

	<div class="welcome" style="text-align:center">@localizer["Welcome_text"]</div>

	<div align="center" class="map-frame">
		<iframe class="framed-map"
				loading="lazy"
				allowfullscreen
				src="https://www.google.com/maps/embed/v1/place?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
    &q=Givaudan,Baierbrunn+Germany&zoom=9">
		</iframe>
	</div>
</body>

@if (currentlyLoggedInUser != null && recommendedAds.Count != 0 && showPopUpRecommendedAds == true)
{
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">@localizer["Have_you_seen_these_ads"]</h3>
						<button type="button" class="close" @onclick="ClosePopUpRecommendedAds"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>@localizer["These_might_be_interesting_for_you"]</p>
						<div class="card-container">
							@foreach (var ad in recommendedAds)
							{
								<div class="card">
									<table>
										<tr>
											<th style="text-align: left">@localizer["Ad_type"]</th>
											<th style="text-align: right">@localizer[@ad.AdType.ToString()]</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["Ad_owner"]</th>
											<th style="text-align: right">@DataService.showUserNameWithStatus(ad.AdOwner)</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["Ad_direction"]</th>
											<th style="text-align: right">@localizer[ad.AdDirection.ToString()]</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["From/to_this_address"]</th>
											<th style="text-align: right">@ad.PickUpDropOffLocation</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
											<th style="text-align: right">@ad.PickUpDateAndTime.ToString("g")</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["Number_of_seats"]</th>
											<th style="text-align: right">@ad.NumberOfSeats</th>
										</tr>
										<tr>
											<th style="text-align: left">@localizer["Specific_requests"]</th>
											<th style="text-align: right">@ad.SpecificRequests</th>
										</tr>
									</table>
									<button @onclick="() => showAd(ad)">@localizer["Show_me_the_ad"]</button>
								</div>
							}
						</div>
						<button type="button" style="margin: 25px; position: center" class="close" @onclick="navigateToRecommendedAds">@localizer["Show_me_all_recommendations"]</button>
					</div>
				</div>
			</div>
		</div>
	}
}




@code {


	List<Ad> recommendedAds;


	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{
		await InvokeAsync(() =>
	{
		StateHasChanged();
	});
	}

	protected override async Task OnParametersSetAsync()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		recommendedAds = await getRecommendedAds();
		showPopUpRecommendedAds = true;
		base.OnParametersSet();
	}

	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
	}


	public static User? currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);

	}


	bool showPopUpRecommendedAds = true;
	/// <summary>
	/// Closes pop up window to show error message about the location being too close to Baierbrunn
	/// </summary>
	public void ClosePopUpRecommendedAds()
	{
		showPopUpRecommendedAds = false;
	}

	/// <summary>
	/// Collects a list of Ads that could be recommended to any ads of a specific user - sorts the ads by pick up date and time, and shows the first 3
	/// </summary>
	/// <returns>List of ads</returns>
	public async Task<List<Ad>> getRecommendedAds()
	{
		var result = context.Ads.Include(u => u.AdOwner).ToList<Ad>().AsQueryable();
		result = result.Where(Ad => Ad.AdOwner == currentlyLoggedInUser);
		List<Ad> recommendedAds = new List<Ad>();
		if (result is null)
		{
			return recommendedAds;
		}
		else
		{
			foreach (Ad ad in result)
			{
				List<Ad> list = Task.Run(async () => await DataService.collectRecommendedAds(ad, currentlyLoggedInUser)).Result;
				recommendedAds.AddRange(list);
			}
			recommendedAds = recommendedAds.OrderBy(a => a.PickUpDateAndTime).ToList();
			recommendedAds = recommendedAds.Take(5).ToList();
			return recommendedAds;
		}
	}


	/// <summary>
	/// Navigates to the page where the user can look up their recommended ads
	/// </summary>
	public void navigateToRecommendedAds()
	{
		NavigationManager.NavigateTo("MyAdsForRecommendations");
	}

	/// <summary>
	/// Redirects the user to a new page showing the one specific ad they want to see
	/// </summary>
	/// <param name="ad">Ad</param>
	public void showAd(Ad ad)
	{
		int id = ad.ID;
		NavigationManager.NavigateTo("ShowAd/" + id);
	}


}


