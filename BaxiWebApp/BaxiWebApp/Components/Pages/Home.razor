<p align="center">
	<iframe width="600"
			height="450"
			loading="lazy"
			allowfullscreen
			src="https://www.google.com/maps/embed/v1/place?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
    &q=Givaudan,Baierbrunn+Germany&zoom=9">
	</iframe>
</p>


<p align="center">
	<iframe width="600"
			height="450"
			loading="lazy"
			allowfullscreen
			src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=Oslo+Norway
			&destination=48.02051251896241, 11.482662196604283
			&avoid=tolls">
	</iframe>
</p>





@code {


	public static User? user;
	public async Task identifyLoggedInUser()
	{
		//example
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		user = await UserManager.GetUserAsync(claims);

		// //changes to uiser ob:
		// user.Contact = "bla";

		// await UserManager.UpdateAsync(user);

	}

	public static string APIKey = Environment.GetEnvironmentVariable("Google_Maps_API_Key");


}


