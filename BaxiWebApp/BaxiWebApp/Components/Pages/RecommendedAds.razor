@page "/RecommendedAds/{ID:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request;
@using GoogleMapsApi.Entities.Directions.Response;
@using GoogleMapsApi.Entities.Geocoding.Request;
@using GoogleMapsApi.Entities.Geocoding.Response;
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Threading.Tasks;
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService
@inject IJSRuntime JSRuntime
@inject IJSRuntime JSRuntime
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer


<AuthorizeView Context="authContext">
	<Authorized>
		<header>
			<link rel="stylesheet" href="styles.css" />
		</header>

		<body>
			@if (currentlyLoggedInUser == CurrentAd.AdOwner)
			{
				<h3 style="text-align:center">@localizer["Recommended_ads"]</h3>

				@if (recommendedAds.Count == 0)
				{
					<p style="text-align:center">@localizer["Unfortunately_there_are_no_ad_recommendations_for_you_please_come_back_later_or_turn_on_the_notifications_so_we_can_inform_you_when_a_matching_ad_is_posted"]</p>
				}
				else
				{
					<div class="row">
						<p style="text-align:center">@localizer["Here_you_will_see_the_ads_that_are_matching_your_selected_ad"]</p>
						<p style="text-align:center">@localizer["Meaning_you_are_going_in_the_same_direction_at_the_same_time_and_your_pick_up_location_or_the_route_you_are_taking_is_close_enough_to_each_other"]</p>
						
						<div class="col">
							<div class="div-block">
								<p>@localizer["Your_original_ad"]</p>
								<div>@localizer["Ad_type"] @localizer[@CurrentAd.AdType.ToString()]</div>
								<div>@localizer["Ad_direction"] @localizer[@CurrentAd.AdDirection.ToString()]</div>
								<div>@localizer["From/to_this_address"] @CurrentAd.PickUpDropOffLocation</div>
								<div>@localizer["Pick_up_date_and_time"] @CurrentAd.PickUpDateAndTime.ToString("g")</div>
								<div>@localizer["Number_of_seats"] @CurrentAd.NumberOfSeats</div>
								<div>@localizer["Specific_requests"] @CurrentAd.SpecificRequests</div>
							</div>
						</div>

						<div class="col">
							<div id="map">
							</div>
							<script>
								(g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})
								({key: "AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk", v: "beta"});</script>
						</div>
					</div>

					<div class="row">
						<p style="text-align:center">@localizer["And_the_possibly_matching_ads"]</p>
						<QuickGrid Items="adListForGrid" @ref="grid">
							<PropertyColumn Title="@localizer["Ad_type"]" Property="@(Ad => @localizer[@Ad.AdType.ToString()])" Sortable="true">
							</PropertyColumn>
							<PropertyColumn Title="@localizer["Ad_direction"]" Property="@(Ad => @localizer[@Ad.AdDirection.ToString()])" Sortable="true">
							</PropertyColumn>
							<PropertyColumn Title="@localizer["From/to_this_address"]" Property="@(Ad => Ad.PickUpDropOffLocation)" Sortable="true">
							</PropertyColumn>
							<PropertyColumn Title="@localizer["Pick_up_date_and_time"]" Property="@(Ad => Ad.PickUpDateAndTime.ToString("g"))" Sortable="true" />
							<PropertyColumn Title="@localizer["Number_of_seats"]" Property="@(Ad => Ad.NumberOfSeats)" Sortable="true" />
							<PropertyColumn Title="@localizer["Specific_requests"]" Property="@(Ad => Ad.SpecificRequests)" Sortable="true" />
							<TemplateColumn Title="@localizer["Show_me_the_ad"]" Context="Ad">
								<button @onclick="() => showAd(Ad)">@localizer["Show_me_the_ad"]</button>
							</TemplateColumn>
						</QuickGrid>
					</div>
				}
			}
		</body>
	</Authorized>
</AuthorizeView>



@code {

	[Parameter]
	public int ID { get; set; }

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
		await JSRuntime.InvokeVoidAsync("initMapForAdList", recommendedAds);
	}


	// Ad CurrentAd;
	List<Ad> recommendedAds = new List<Ad>();

	QuickGrid<Ad>? grid;

	//coordinates of Baierbrunn
	public double latitudeBB = 48.0206345131560;
	public double longitudeBB = 11.482919688669709;

	public Ad? CurrentAd
	{
		get
		{
			var result = context.Ads.FirstOrDefault(ad => ad.ID == ID);
			return result;
		}
	}

	public async Task<Ad> getCurrentAd(int ID)
	{
		var result = context.Ads.FirstOrDefault(ad => ad.ID == ID);
		return result;
	}


	// protected override async Task OnParametersSetAsync()
	// {
	// 	recommendedAds = await collectRecommendedAds(CurrentAd);
	// 	await identifyLoggedInUser();
	// 	await base.OnParametersSetAsync();
	// }
	protected override void OnParametersSet()
	{
		recommendedAds = Task.Run(async () => await DataService.collectRecommendedAds(CurrentAd, currentlyLoggedInUser)).Result;
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}



	public User currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}


	IQueryable<Ad> adListForGrid
	{
		get
		{
			var result = recommendedAds.AsQueryable();
			return result;
		}
	}






	/// <summary>
	/// Redirects the user to a new page showing the one specific ad they want to see
	/// </summary>
	/// <param name="ad">Ad</param>
	public void showAd(Ad ad)
	{
		int id = ad.ID;
		NavigationManager.NavigateTo("ShowAd/" + id);
	}






}
