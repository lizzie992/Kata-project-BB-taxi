@page "/MyAds"

@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager

<AuthorizeView Context="authContext">
    <Authorized>


        <h3>My Ads</h3>


        @if (FilteredAds.ToArray().Length == 0)
        {
            <div>You do not have any ads :) You can create ads by clicking on Create Ad in the menu!</div>
        }
        else
        {
            <p>Click on the title of the column to sort it!</p>
            <div>
                <QuickGrid Items="FilteredAds" @ref="grid">

                    <PropertyColumn Title="Ad type:" Property="@(Ad => Ad.AdType)" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="Ad Direction:" Property="@(Ad => Ad.AdDirection)" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="From/To address:" Property="@(Ad => Ad.PickUpDropOffLocation)" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="Pick up date and time:" Property="@(Ad => Ad.PickUpDateAndTime)" Sortable="true" />
                    <PropertyColumn Title="Number of seats:" Property="@(Ad => Ad.NumberOfSeats)" Sortable="true" />
                    <PropertyColumn Title="Specific requests:" Property="@(Ad => Ad.SpecificRequests)" Sortable="true" />
                    <TemplateColumn Title="Modify Ads" Context="Ad">
                        <button class="btn btn-primary btn-sm mx-1" @onclick="() => ModifyAd(Ad)">Edit me!</button>
                    </TemplateColumn>
                    <TemplateColumn Title="Delete Ads" Context="Ad">
                        <button class="btn btn-primary btn-sm mx-1" @onclick="() => showPopUpForDeletingAd(Ad)">Delete me!</button>
                    </TemplateColumn>
                </QuickGrid>

            </div>
        }

        @if (popUpForDeletingAd)
        {
            <div class="modal" tabindex="-1" style="display:block" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h3 class="modal-title">Delete this ad!</h3>
                            <button type="button" class="close" @onclick="closePopUpForDeletingAd"> <span area-hidden="true">X</span></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete it?</p>
                            <button type="button" class="close" @onclick="() => DeleteAd(selectedAd)">Delete it!</button>
                        </div>
                    </div>
                </div>
            </div>

        }

    </Authorized>
</AuthorizeView>

@code {
    int adId { get; set; }
    public User user;
    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        user = await UserManager.GetUserAsync(claims);
    }


    public static List<Ad> AdList = new List<Ad>();
    protected override void OnParametersSet()
    {
        identifyLoggedInUser();
        AdList = context.Ads.ToList<Ad>();
        base.OnParametersSet();
    }

    QuickGrid<Ad>? grid;
    IQueryable<Ad> FilteredAds
    {
        get
        {
            var result = context.Ads.ToList<Ad>().AsQueryable();
            result = result.Where(Ad => Ad.AdOwner == user);
            return result;
        }
    }

    private int ID;
    public void ModifyAd(Ad ad)
    {
        ID = ad.ID;
        NavigationManager.NavigateTo("ModifyAd/" + ID);
    }

    private void DeleteAd(Ad ad)
    {
        context.Ads.Remove(ad);
        context.SaveChanges();
        closePopUpForDeletingAd();
        grid.RefreshDataAsync();
    }

    Ad selectedAd;
    bool popUpForDeletingAd = false;

    public void closePopUpForDeletingAd()
    {
        popUpForDeletingAd = false;
    }

    public void showPopUpForDeletingAd(Ad ad)
    {
        selectedAd = ad;
        popUpForDeletingAd = true;
    }

}
