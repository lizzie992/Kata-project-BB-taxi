@page "/MyAds"

@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Data.BaxiWebAppContext context;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using System.Globalization;


<AuthorizeView Context="authContext">
    <Authorized>


        <h3>@localizer["My_ads"]</h3>


        @if (FilteredAds.ToArray().Length == 0)
        {
            <div>@localizer["You_do_not_have_any_ads_you_can_create_ads_by_clicking_on_Create_Ad_in_the_menu"]</div>
        }
        else
        {
            <p>@localizer["Click_on_the_title_of_the_column_to_sort_it"]</p>
            <div>
                <QuickGrid Items="FilteredAds" @ref="grid">

                    <PropertyColumn Title="@localizer["Ad_type"]" Property="@(Ad => @localizer[@Ad.AdType.ToString()])" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="@localizer["Ad_direction"]" Property="@(Ad => @localizer[@Ad.AdDirection.ToString()])" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="@localizer["From/to_this_address"]" Property="@(Ad => Ad.PickUpDropOffLocation)" Sortable="true">
                    </PropertyColumn>
                    <PropertyColumn Title="@localizer["Pick_up_date_and_time"]" Property="@(Ad => Ad.PickUpDateAndTime.ToString("g"))" Sortable="true" />
                    <PropertyColumn Title="@localizer["Number_of_seats"]" Property="@(Ad => Ad.NumberOfSeats)" Sortable="true" />
                    <PropertyColumn Title="@localizer["Specific_requests"]" Property="@(Ad => Ad.SpecificRequests)" Sortable="true" />
                    <TemplateColumn Title="@localizer["Modify_ad"]" Context="Ad">
                        <button class="btn btn-primary btn-sm mx-1" @onclick="() => ModifyAd(Ad)">@localizer["Modify_ad"]</button>
                    </TemplateColumn>
                    <TemplateColumn Title="@localizer["Delete_ad"]" Context="Ad">
                        <button class="btn btn-primary btn-sm mx-1" @onclick="() => showPopUpForDeletingAd(Ad)">@localizer["Delete_ad"]</button>
                    </TemplateColumn>
                </QuickGrid>

            </div>
        }

        @if (popUpForDeletingAd)
        {
            <div class="modal" tabindex="-1" style="display:block" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h3 class="modal-title">@localizer["Delete_ad"]</h3>
                            <button type="button" class="close" @onclick="closePopUpForDeletingAd"> <span area-hidden="true">X</span></button>
                        </div>
                        <div class="modal-body">
                            <p>@localizer["Are_you_sure_you_want_to_delete_it"]</p>
                            <button type="button" class="close" @onclick="() => DeleteAd(selectedAd)">@localizer["Delete_ad"]</button>
                        </div>
                    </div>
                </div>
            </div>

        }

    </Authorized>
</AuthorizeView>

@code {
    int adId { get; set; }
    public User user;
    /// <summary>
    /// Identifies the user who is currently logged in
    /// </summary>
    /// <returns>User</returns>
    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        user = await UserManager.GetUserAsync(claims);
    }


    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
        if (firstrender)
        {
            DataService.loadCulture(user);
        }
    }

    protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

    public async void OnCultureChanged(object sender, CultureInfo culture)
    {

        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    public static List<Ad> AdList = new List<Ad>();
    protected override void OnParametersSet()
    {
        identifyLoggedInUser();
        AdList = context.Ads.ToList<Ad>();
        base.OnParametersSet();
    }

    QuickGrid<Ad>? grid;
    IQueryable<Ad> FilteredAds
    {
        get
        {
            var result = context.Ads.ToList<Ad>().AsQueryable();
            result = result.Where(Ad => Ad.AdOwner == user);
            return result;
        }
    }

    private int ID;
    /// <summary>
    /// Redirects the user to the Modify Ad page using the ID number of the selected ad that the user wants to modify
    /// </summary>
    /// <param name="ad">Ad</param>
    public void ModifyAd(Ad ad)
    {
        ID = ad.ID;
        NavigationManager.NavigateTo("ModifyAd/" + ID);
    }

    /// <summary>
    /// Removes the selected ad from the database
    /// </summary>
    /// <param name="ad">Ad</param>
    private void DeleteAd(Ad ad)
    {
        context.Ads.Remove(ad);
        context.SaveChanges();
        closePopUpForDeletingAd();
        grid.RefreshDataAsync();
    }

    Ad selectedAd;
    bool popUpForDeletingAd = false;
    /// <summary>
	/// Closes pop up window to confirm ad deletion
	/// </summary>
    public void closePopUpForDeletingAd()
    {
        popUpForDeletingAd = false;
    }

    /// <summary>
	/// Opens pop up window to confirm ad deletion
	/// </summary>
    public void showPopUpForDeletingAd(Ad ad)
    {
        selectedAd = ad;
        popUpForDeletingAd = true;
    }

}
