@page "/ShowAd/{ID:int}"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Net.Mail
@using System.Net
@using System.IO
@using System.Text;
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request;
@using GoogleMapsApi.Entities.Directions.Response;
@using GoogleMapsApi.Entities.Geocoding.Request;
@using GoogleMapsApi.Entities.Geocoding.Response;
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Globalization;
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService
@inject IJSRuntime JSRuntime
@using BaxiWebApp.Data
@inject IDbContextFactory<BaxiWebAppContext> DbContextFactory
@using Microsoft.EntityFrameworkCore


<PageTitle>@localizer["Show_me_the_ad"]</PageTitle>

<body>
	@if (CurrentAd is null)
	{
		<p>@localizer["This_ad_must_have_been_deleted"]</p>
	}

	@if (currentlyLoggedInUser?.isActive == false)
	{
		<p style="text-align:center; font-size:150%;">@localizer["You_are_inactivated_this_page_is_not_available_for_you"]</p>
	}
	else
	{
		<div class="row">
			<div class="col" align="center">
				@if (CurrentAd?.AdDirection == AdDirection.ToBaierbrunn)
				{
					<div align="center" class="map-frame-for-showad">
						<iframe class="framed-map"
								width=" 600"
								height="450"
								loading="lazy"
								allowfullscreen
								src="https://www.google.com/maps/embed/v1/directions
																													?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
																													&origin=@CurrentAd.Latitude?.ToString("F8", CultureInfo.InvariantCulture), @CurrentAd.Longitude?.ToString("F8", CultureInfo.InvariantCulture)
																													&destination=Givaudan,Baierbrunn+Germany
																													&avoid=tolls">
						</iframe>
					</div>

				}

				@if (CurrentAd?.AdDirection == AdDirection.FromBaierbrunn)
				{
					<div align="center" class="map-frame-for-showad">
						<iframe class="framed-map"
								width="600"
								height="450"
								loading="lazy"
								allowfullscreen
								src="https://www.google.com/maps/embed/v1/directions
																													?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
																													&origin=Givaudan,Baierbrunn+Germany
																													&destination=@CurrentAd.Latitude?.ToString("F8", CultureInfo.InvariantCulture), @CurrentAd.Longitude?.ToString("F8", CultureInfo.InvariantCulture)
																													&avoid=tolls">
						</iframe>
					</div>

				}
			</div>
		</div>

		@if (CurrentAd is not null)
		{
			<div class="row">
				<div class="col" align="center">
					<div class="card">
						<table>
							<tr>
								<th style="text-align: left">@localizer["Ad_type"]</th>
								<th style="text-align: right">@localizer[@CurrentAd.AdType.ToString()]</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["Ad_owner"]</th>
								<th style="text-align: right">@DataService.showUserNameWithStatus(CurrentAd.AdOwner)</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["Ad_direction"]</th>
								<th style="text-align: right">@localizer[CurrentAd.AdDirection.ToString()]</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["From/to_this_address"]</th>
								<th style="text-align: right">@CurrentAd.PickUpDropOffLocation</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
								<th style="text-align: right">@CurrentAd.PickUpDateAndTime.ToString("g")</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["Number_of_seats"]</th>
								<th style="text-align: right">@CurrentAd.NumberOfSeats</th>
							</tr>
							<tr>
								<th style="text-align: left">@localizer["Specific_requests"]</th>
								<th style="text-align: right">@CurrentAd.SpecificRequests</th>
							</tr>
						</table>
						@if (CurrentAd.PickUpDateAndTime >= DateTime.Now.AddMinutes(-30) && currentlyLoggedInUser.Id != CurrentAd.AdOwner.Id)
						{
							<button @onclick="() => openChat(CurrentAd)">@localizer["Contact_me"]</button>
						}

						<button @onclick="() => showPopUpForReportAd(CurrentAd)">@localizer["Report_ad"]</button>
					</div>
				</div>
			</div>
		}




		//new pop up for reporting ads:
		<div class="modal fade" id="reportAdModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="exampleModalLabel">@localizer["Report_ad"]</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Please_write_here_the_reason_for_the_reporting_this_ad"]</p>
						<InputText @bind-Value="reasonForReporting"></InputText>
					</div>
					<div class="modal-footer">
						<button type="button" data-bs-dismiss="modal" class="close" @onclick="() => reportAd(selectedAd, reasonForReporting)">@localizer["Report_ad"]</button>
					</div>
				</div>
			</div>
		</div>

		@* @if (popUpForReportAd)
		{
			<div class="modal" tabindex="-1" style="display:block" role="dialog">
				<div class="modal-dialog">
					<div class="modal-content">
						<div class="modal-header">
							<h3 class="modal-title">@localizer["Report_ad"]</h3>
							<button type="button" class="close" @onclick="closePopUpForReportAd"> <span area-hidden="true">X</span></button>
						</div>
						<div class="modal-body">
							<p>@localizer["Please_write_here_the_reason_for_the_reporting_this_ad"]</p>
							<InputText @bind-Value="reasonForReporting"></InputText>
							<button type="button" class="close" @onclick="() => reportAd(selectedAd, reasonForReporting)">@localizer["Report_ad"]</button>
						</div>
					</div>
				</div>
			</div>
		} *@


		//new pop up for new conversation starter:
		<div class="modal fade" id="conversationModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="exampleModalLabel">@localizer["Please_write_your_first_message_here"]</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Your_first_message"]</p>
						<InputText class="inputText" @bind-Value="message"></InputText>
					</div>
					<div class="modal-footer">
						<button type="button" data-bs-dismiss="modal" @onclick="() => createChat(selectedAd)">@localizer["Send"]</button>
					</div>
				</div>
			</div>
		</div>

		@* @if (popUpForNewConversation)
		{
			<div class="modal" tabindex="-1" style="display:block" role="dialog">
				<div class="modal-dialog">
					<div class="modal-content">
						<div class="modal-header">
							<h3 class="modal-title">@localizer["Please_write_your_first_message_here"]</h3>
							<button type="button" class="close" @onclick="closePopUpForNewConversation"> <span area-hidden="true">X</span></button>
						</div>
						<div class="modal-body">
							<p>@localizer["Your_first_message"]</p>
							<InputText @bind-Value="message"></InputText>
							<button type="button" class="close" @onclick="() => createChat(selectedAd)">@localizer["Send"]</button>
						</div>
					</div>
				</div>
			</div>
		} *@

	}
</body>




@code {

	[Parameter]
	public int? ID { get; set; }
	public string reasonForReporting = "";


	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object? sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	public Ad? CurrentAd
	{
		get
		{
			using var context = DbContextFactory.CreateDbContext();
			var result = context.Ads.Include(u => u.AdOwner).FirstOrDefault(ad => ad.ID == ID);
			return result;
		}
	}

	// protected override async Task OnParametersSetAsync()
	// {
	// 	// await identifyLoggedInUser();
	// 	base.OnParametersSet();
	// }

	[CascadingParameter(Name = "currentlyLoggedInUser")]
	private User? currentlyLoggedInUser { get; set; }


	public string message = "";

	// public User? currentlyLoggedInUser;
	// /// <summary>
	// /// Identifies the user who is currently logged in
	// /// </summary>
	// /// <returns>User</returns>
	// public async Task identifyLoggedInUser()
	// {
	// 	var authState = await AuthStateProvider.GetAuthenticationStateAsync();

	// 	var claims = authState.User;

	// 	currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	// }


	protected override void OnAfterRender(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
	}

	/// <summary>
	/// First checks if there is already an existing conversation between the 2 users (the currently logged in user and the ad owner) connected to this ad, if there is, it redirects the user to that chat conversation
	/// If there is no such a conversation, it opens the pop up window for the first message to be sent (using createChat method)
	/// </summary>
	/// <param name="ad">Ad</param>
	public void openChat(Ad ad)
	{
		List<Conversation>? previousConversations = DataService.findPreviousConvo(ad, currentlyLoggedInUser);
		if (previousConversations.ToList().Count != 0)
		{
			Conversation? conversation = previousConversations.FirstOrDefault();
			if (conversation is not null)
			{
				NavigationManager.NavigateTo("Chat/" + conversation.ID);  //find id of conversation    //navigate to chat page with conversation id
			}
		}
		else        //if not found, create new conversasion (+id)
		{
			showPopUpForNewConversation(ad);
		}
	}



	/// <summary>
	/// It creates a new conversation between the 2 users (the currently logged in user and the ad owner) connected to this ad, and redirects the user to the chat conversation
	/// </summary>
	/// <param name="ad">Ad</param>
	public void createChat(Ad? ad)
	{
		if (ad is not null && currentlyLoggedInUser is not null)
		{
			Conversation conversation = DataService.createConvo(ad, currentlyLoggedInUser, message);
			int id = conversation.ID;
			NavigationManager.NavigateTo("Chat/" + id);
		}

	}


	/// <summary>
	/// Triggers the dataservice method to report the selected ad to the admins
	/// </summary>
	/// <param name="ad">Ad</param>
	/// <param name="reasonForReporting">string</param>
	public void reportAd(Ad? ad, string reasonForReporting)
	{
		using var context = DbContextFactory.CreateDbContext();
		context.Attach(ad);
		foreach (User u in context.Users.ToList<User>())
		{
			if (isUserAdmin())
			{
				if (u.Email is not null && ad is not null)
				{
					string emailAddress = u.Email.ToString();
					string adDetails = localizer["Ad_owner_{0}_ad_type_{1}_ad_direction_{2}_address_{3}_pick_up_date_and_time_{4}_number_of_seats_{5}_specific_requests_{6}", DataService.showUserNameWithStatus(ad.AdOwner), ad.AdType, ad.AdDirection, ad.PickUpDropOffLocation, ad.PickUpDateAndTime, ad.NumberOfSeats, ad.SpecificRequests];
					string subject = localizer["An_ad_was_just_reported_to_you"];
					string text = localizer["Please_check_out_the_following_ad_below_that_{0}_reported_to_you_{1}_the_reason_for_reporting_is_{2}_open_the_ad_here_http_localhost_5049_ShowAd_{3}", DataService.showUserNameWithStatus(currentlyLoggedInUser), adDetails, reasonForReporting, ad.ID];
					DataService.sendEmail(emailAddress, subject, text);
				}
			}
		}
		closePopUpForReportAd();
	}


	public bool isUserAdmin()
	{
		using var context = DbContextFactory.CreateDbContext();
		IList<string> list = Task.Run(() => UserManager.GetRolesAsync(currentlyLoggedInUser)).Result;
		if (list.Contains("Admin"))
		{
			return true;
		}
		return false;
	}

	Ad? selectedAd;

	bool popUpForReportAd = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about reporting the ad
	/// </summary>
	public void closePopUpForReportAd()
	{
		popUpForReportAd = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about reporting the ad
	/// </summary>
	public async void showPopUpForReportAd(Ad ad)
	{
		selectedAd = ad;
		try
		{
			await JSRuntime.InvokeVoidAsync("blazorModal.show", "reportAdModal");
		}
		catch (ArgumentException e)
		{
			Console.WriteLine($"Modal failed to display: {e.Message}");
		}
		
		popUpForReportAd = true;
	}

	bool popUpForNewConversation = false;

	/// <summary>
	/// Closes pop up window regarding new conversation
	/// </summary>
	public void closePopUpForNewConversation()
	{
		popUpForNewConversation = false;
		message = "";
	}

	/// <summary>
	/// Opens pop up window regarding new conversation
	/// </summary>
	public async void showPopUpForNewConversation(Ad ad)
	{
		selectedAd = ad;
		try
		{
			await JSRuntime.InvokeVoidAsync("blazorModal.show", "conversationModal");
		}
		catch (ArgumentException e)
		{
			Console.WriteLine($"Modal failed to display: {e.Message}");
		}
		
		popUpForNewConversation = true;
	}


}
