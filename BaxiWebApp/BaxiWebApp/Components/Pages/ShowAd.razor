@page "/ShowAd/{ID:int}"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Net.Mail
@using System.Net
@using System.IO
@using System.Text;
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request;
@using GoogleMapsApi.Entities.Directions.Response;
@using GoogleMapsApi.Entities.Geocoding.Request;
@using GoogleMapsApi.Entities.Geocoding.Response;
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Globalization;
@using Microsoft.EntityFrameworkCore;
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService


@if (CurrentAd is null)
{
	<p>This ad must have been deleted!</p>
}

@if (currentlyLoggedInUser.isActive == false)
{
	<p style="text-align:center; font-size:150%;">You are inactivated, this page is not available for you</p>
}
else
{
	<h3>Ad</h3>

	@if (CurrentAd.AdDirection == AdDirection.ToBaierbrunn)
	{
		<p align="center">
			<iframe width="600"
					height="450"
					loading="lazy"
					allowfullscreen
					src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=@CurrentAd.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @CurrentAd.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&destination=Givaudan,Baierbrunn+Germany
			&avoid=tolls">
			</iframe>
		</p>

	}

	@if (CurrentAd.AdDirection == AdDirection.FromBaierbrunn)
	{
		<p align="center">
			<iframe width="600"
					height="450"
					loading="lazy"
					allowfullscreen
					src="https://www.google.com/maps/embed/v1/directions
			?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
			&origin=Givaudan,Baierbrunn+Germany
			&destination=@CurrentAd.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @CurrentAd.Longitude?.ToString("F8",CultureInfo.InvariantCulture)
			&avoid=tolls">
			</iframe>
		</p>

	}

	

	<div>Ad type: @CurrentAd.AdType</div>
	<div>Ad owner: @DataService.showUserNameWithStatus(CurrentAd.AdOwner)</div>
	<div>Ad Direction: @CurrentAd.AdDirection</div>
	<div>Pick up or drop off location: @CurrentAd.PickUpDropOffLocation</div>
	<div>Pick up Date and Time: @CurrentAd.PickUpDateAndTime</div>
	<div>Number of seats: @CurrentAd.NumberOfSeats</div>
	<div>Specific requests: @CurrentAd.SpecificRequests</div>

	@if (CurrentAd.PickUpDateAndTime >= DateTime.Now.AddMinutes(-30) && currentlyLoggedInUser != CurrentAd.AdOwner)
	{
		<button @onclick="() => createChat(CurrentAd)">Contact me!</button>
	}

	<button @onclick="() => showPopUpForReportAd(CurrentAd)">Report ad!</button>

	@if (popUpForReportAd)
	{
		<div class="modal" tabindex="-1" style="display:block" role="dialog">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h3 class="modal-title">Report this ad</h3>
						<button type="button" class="close" @onclick="closePopUpForReportAd"> <span area-hidden="true">X</span></button>
					</div>
					<div class="modal-body">
						<p>Please write here the reason for the reporting this ad:</p>
						<InputText @bind-Value="reasonForReporting"></InputText>
						<button type="button" class="close" @onclick="() => reportAd(selectedAd, reasonForReporting)">Report this ad!</button>
					</div>
				</div>
			</div>
		</div>

	}

}





@code {

	[Parameter]
	public int? ID { get; set; }
	public string reasonForReporting = "";

	public Ad? CurrentAd
	{
		get
		{
			var result = context.Ads.Include(u => u.AdOwner).FirstOrDefault(ad => ad.ID == ID);
			return result;
		}
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	/// <summary>
	/// First checks if there is already an existing conversation between the 2 users (the currently logged in user and the ad owner) connected to this ad, if there is, it redirects the user to that chat conversation
	/// If there is no such a conversation, then it creates one between the 2 users (the currently logged in user and the ad owner) connected to this ad, and redirects the user to the chat conversation
	/// </summary>
	/// <param name="ad">Ad</param>
	public void createChat(Ad ad)
	{
		//check current ad if matching conversation exists:
		var previousConversations = ad.adConversations.AsQueryable();
		previousConversations = previousConversations.Where(Conversation => Conversation.contactingUser == currentlyLoggedInUser);
		if (previousConversations.ToList().Count != 0)
		{
			Conversation conversation = previousConversations.FirstOrDefault();
			NavigationManager.NavigateTo("Chat/" + conversation.ID);  //find id of conversation    //navigate to chat page with conversation id
		}
		else        //if not found, create new conversasion (+id)
		{
			Conversation conversation = new();
			conversation.adOwnerUser = ad.AdOwner;
			conversation.contactingUser = currentlyLoggedInUser;
			conversation.messages = new List<Message>();
			//in service
			//add new conversation boject to context
			ad.adConversations.Add(conversation);
			// savechanges
			context.SaveChanges();
			int id = conversation.ID;
			NavigationManager.NavigateTo("Chat/" + id);
		}
	}

	/// <summary>
	/// Triggers the dataservice method to report the selected ad to the admins
	/// </summary>
	/// <param name="ad">Ad</param>
	/// <param name="reasonForReporting">string</param>
	public void reportAd(Ad ad, string reasonForReporting)
	{
		DataService.reportAd(ad, currentlyLoggedInUser, reasonForReporting);
		closePopUpForReportAd();
	}


	Ad selectedAd;

	bool popUpForReportAd = false;
	/// <summary>
	/// Closes pop up window to show confirmation message about reporting the ad
	/// </summary>
	public void closePopUpForReportAd()
	{
		popUpForReportAd = false;
	}
	/// <summary>
	/// Opens pop up window to show confirmation message about reporting the ad
	/// </summary>
	public void showPopUpForReportAd(Ad ad)
	{
		selectedAd = ad;
		popUpForReportAd = true;
	}
}
