@page "/Ads"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService
@inject IJSRuntime JSRuntime
@using Pages.Res;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer

<AuthorizeView Context="authContext">
	<Authorized>
		<body>
			@if (currentlyLoggedInUser.isActive == false)
			{
				<p style="text-align:center; font-size:150%;">@localizer["You_are_inactivated_this_page_is_not_available_for_you"]</p>
			}
			else
			{
				<p style="text-align:center; font-size:150%;">@localizer["Here_you_can_see_all_of_the_ads"]</p>
				<div class="container text-center">
					<div class="row">
						<div class="col-12 col-md-6">
							<div class="div-block">
								<div class="input-block">
									<div>@localizer["I_am_looking_for_a"]</div>
									<InputSelect class="input" @bind-Value="_adType" id="adType">
										@foreach (var value in Enum.GetValues<AdType>())
										{
											<option value="@value">@localizer[value.ToString()]</option>
										}
									</InputSelect>
								</div>

								<div class="input-block">
									<div>@localizer["Direction"]</div>
									<InputSelect class="input" @bind-Value="_adDirection" id="adDirection">
										@foreach (var value in Enum.GetValues<AdDirection>())
										{
											<option value="@value">@localizer[value.ToString()]</option>
										}
									</InputSelect>
								</div>

								<div class="input-block">
									<div>@localizer["From/to_this_address"]</div>
									<input class="input" type="search" autofocus @bind="_searchAddress" @bind:event="oninput" placeholder="@localizer["Address..."]" />
								</div>

								<div class="input-block">
									<div>@localizer["Between_the_following_date_and_time"]</div>
									<InputDate Type="InputDateType.DateTimeLocal" class="input"
											   min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime1">
									</InputDate>
									<InputDate Type="InputDateType.DateTimeLocal" class="input"
											   min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime2">
									</InputDate>
								</div>

								<div class="input-block">
									<div>@localizer["Number_of_seats"]</div>
									<InputSelect class="input" @bind-Value="_requestedSeats" id="numberOfSeats">
										<option value="-1">@localizer["All"]</option>
										<option value="1">1</option>
										<option value="2">2</option>
										<option value="3">3</option>
										<option value="4">4</option>
										<option value="5">5</option>
										<option value="6">6</option>
									</InputSelect>
								</div>

							</div>
						</div>

						<div class="col-12 col-md-6">
							<div id="map">
							</div>
							<script>
								(g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})
								({key: "AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk", v: "beta"});</script>
						</div>
					</div>

					<div class="row">
						<div class="col">
							<div class="grid-wrapper">
								<QuickGrid Items="FilteredAds" class="quickgrid" @ref="grid">
									<PropertyColumn Title="@localizer["Ad_type"]" Property="@(Ad => @localizer[@Ad.AdType.ToString()])">
									</PropertyColumn>
									<PropertyColumn Title="@localizer["Ad_direction"]" Property="@(Ad => @localizer[@Ad.AdDirection.ToString()])">
									</PropertyColumn>
									<PropertyColumn Title="@localizer["From/to_this_address"]" Property="@(Ad => Ad.PickUpDropOffLocation)">
									</PropertyColumn>
									<PropertyColumn Title="@localizer["Pick_up_date_and_time"]" Property="@(Ad => Ad.PickUpDateAndTime.ToString("g"))" />
									<PropertyColumn Title="@localizer["Number_of_seats"]" Property="@(Ad => Ad.NumberOfSeats)" />
									<PropertyColumn Title="@localizer["Specific_requests"]" Property="@(Ad => Ad.SpecificRequests)" />
									<TemplateColumn Title="@localizer["Show_me_the_ad"]" Context="Ad">
										<button @onclick="() => showAd(Ad)">@localizer["Show_me_the_ad"]</button>
									</TemplateColumn>
									<TemplateColumn Title="@localizer["Contact_me"]" Context="Ad">
										@if (Ad.PickUpDateAndTime >= currentTime && currentlyLoggedInUser != Ad.AdOwner)
										{
											<button @onclick="() => openChat(Ad)">@localizer["Contact_me"]!</button>
										}
									</TemplateColumn>
									@if (UserManager.GetRolesAsync(currentlyLoggedInUser).Result.First() == "Admin")
									{
										<TemplateColumn Title="@localizer["Delete_ad"]" Context="Ad">
											<button @onclick="() => showPopUpForDeletingAd(Ad)">@localizer["Delete_ad"]</button>
										</TemplateColumn>
									}
								</QuickGrid>
							</div>
							<div class="card-container-for-grid">
								@foreach (Ad ad in FilteredAds)
								{
									<div class="card">
										<table>
											<tr>
												<th style="text-align: left">@localizer["Ad_type"]</th>
												<th style="text-align: right">@localizer[@ad.AdType.ToString()]</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["Ad_owner"]</th>
												<th style="text-align: right">@DataService.showUserNameWithStatus(ad.AdOwner)</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["Ad_direction"]</th>
												<th style="text-align: right">@localizer[ad.AdDirection.ToString()]</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["From/to_this_address"]</th>
												<th style="text-align: right">@ad.PickUpDropOffLocation</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["Pick_up_date_and_time"]</th>
												<th style="text-align: right">@ad.PickUpDateAndTime.ToString("g")</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["Number_of_seats"]</th>
												<th style="text-align: right">@ad.NumberOfSeats</th>
											</tr>
											<tr>
												<th style="text-align: left">@localizer["Specific_requests"]</th>
												<th style="text-align: right">@ad.SpecificRequests</th>
											</tr>
										</table>
										<button @onclick="() => showAd(ad)">@localizer["Show_me_the_ad"]</button>
										@if (ad.PickUpDateAndTime >= currentTime && currentlyLoggedInUser != ad.AdOwner)
										{
											<button @onclick="() => openChat(ad)">@localizer["Contact_me"]!</button>
										}
										@if (UserManager.GetRolesAsync(currentlyLoggedInUser).Result.First() == "Admin")
										{
											<button @onclick="() => showPopUpForDeletingAd(ad)">@localizer["Delete_ad"]</button>
										}
									</div>
								}
							</div>
						</div>
					</div>
				</div>



				@if (popUpForDeletingAd)
				{
					<div class="modal" tabindex="-1" style="display:block" role="dialog">
						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h3 class="modal-title">@localizer["Delete_ad"]</h3>
									<button type="button" class="close" @onclick="closePopUpForDeletingAd"> <span area-hidden="true">X</span></button>
								</div>
								<div class="modal-body">
									<p>@localizer["Please_write_here_the_reason_for_deleting_this_ad"]</p>
									<InputText class="inputText" @bind-Value="reasonForDeleting"></InputText>
									<button type="button" class="close" @onclick="() => deleteAd(selectedAd, reasonForDeleting)">@localizer["Delete_ad"]</button>
								</div>
							</div>
						</div>
					</div>

				}


				@if (popUpForNewConversation)
				{
					<div class="modal" tabindex="-1" style="display:block" role="dialog">
						<div class="modal-dialog">
							<div class="modal-content">
								<div class="modal-header">
									<h3 class="modal-title">@localizer["Please_write_your_first_message_here"]</h3>
									<button type="button" class="close" @onclick="closePopUpForNewConversation"> <span area-hidden="true">X</span></button>
								</div>
								<div class="modal-body">
									<p>@localizer["Your_first_message"]</p>
									<InputText class="inputText" @bind-Value="message"></InputText>
									<button type="button" class="close" @onclick="() => createChat(selectedAd)">@localizer["Send"]</button>
								</div>
							</div>
						</div>
					</div>

				}

			}

		</body>
	</Authorized>
</AuthorizeView>


@code {

	public static List<Ad> AdList = new List<Ad>();

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	public List<Ad> adListForMap
	{
		get
		{
			var result = context.Ads.Include(a => a.AdOwner).Include(a => a.adConversations).ToList<Ad>().AsQueryable();

			result = result.Where(Ad =>
							Ad.PickUpDropOffLocation.Contains(_searchAddress, StringComparison.CurrentCultureIgnoreCase)
				&& Ad.NumberOfSeats >= _requestedSeats
				&& _datetime1 <= Ad.PickUpDateAndTime
				&& Ad.PickUpDateAndTime <= _datetime2);

			if (_adType != AdType.SelectAll)
			{
				result = result.Where(Ad => Ad.AdType == _adType);
			}
			if (_adDirection != AdDirection.SelectAll)
			{
				result = result.Where(Ad => Ad.AdDirection == _adDirection);
			}

			return result.ToList();
		}
	}


	DateTime currentTime = DateTime.Now.AddMinutes(-30);

	protected override void OnParametersSet()
	{
		AdList = context.Ads.ToList<Ad>();
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}


	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
		await JSRuntime.InvokeVoidAsync("initMapForAdList", adListForMap, localizer["Beautiful_baierbrunn"].ToString(), localizer["ToBaierbrunn"].ToString(), localizer["FromBaierbrunn"].ToString(), localizer["No_default_type"].ToString(), localizer["Driver"].ToString(), localizer["Passenger"].ToString(), localizer["Show_me_the_ad"].ToString(), localizer["Direction"].ToString(), localizer["Ad_type"].ToString(), localizer["Pick_up_date_and_time"].ToString(), localizer["From/to_this_address"].ToString(), localizer["Number_of_seats"].ToString(), localizer["Show_me_the_ad"].ToString());
	}



	string? _searchAddress = "";
	int _requestedSeats = -1;

	BB.AdType _adType = AdType.SelectAll;
	BB.AdDirection _adDirection = AdDirection.SelectAll;

	public static string allAdTypes;


	DateTime _datetime1 = DateTime.Now;
	DateTime _datetime2 = DateTime.Now.AddDays(90);




	QuickGrid<Ad>? grid;

	IQueryable<Ad> FilteredAds
	{
		get
		{
			var result = context.Ads.Include(a => a.AdOwner).Include(a => a.adConversations).ToList<Ad>().AsQueryable();

			result = result.Where(Ad =>
							Ad.PickUpDropOffLocation.Contains(_searchAddress, StringComparison.CurrentCultureIgnoreCase)
				&& Ad.NumberOfSeats >= _requestedSeats
				&& _datetime1 <= Ad.PickUpDateAndTime
				&& Ad.PickUpDateAndTime <= _datetime2);

			if (_adType != AdType.SelectAll)
			{
				result = result.Where(Ad => Ad.AdType == _adType);
			}
			if (_adDirection != AdDirection.SelectAll)
			{
				result = result.Where(Ad => Ad.AdDirection == _adDirection);
			}

			return result;
		}
	}

	/// <summary>
	/// First checks if there is already an existing conversation between the 2 users (the currently logged in user and the ad owner) connected to this ad, if there is, it redirects the user to that chat conversation
	/// If there is no such a conversation, it opens the pop up window for the first message to be sent (using createChat method)
	/// </summary>
	/// <param name="ad">Ad</param>
	public void openChat(Ad ad)
	{
		List<Conversation> previousConversations = DataService.findPreviousConvo(ad, currentlyLoggedInUser);
		if (previousConversations.ToList().Count != 0)
		{
			Conversation conversation = previousConversations.FirstOrDefault();
			NavigationManager.NavigateTo("Chat/" + conversation.ID);  //find id of conversation    //navigate to chat page with conversation id
		}
		else        //if not found, create new conversasion (+id)
		{
			showPopUpForNewConversation(ad);
		}
	}

	public string message = "";

	/// <summary>
	/// It creates a new conversation between the 2 users (the currently logged in user and the ad owner) connected to this ad, and redirects the user to the chat conversation
	/// </summary>
	/// <param name="ad">Ad</param>
	public void createChat(Ad ad)
	{
		Conversation conversation = DataService.createConvo(ad, currentlyLoggedInUser, message);
		string emailMessage = localizer["You_just_received_a_new_message_from_{0}_Go_and_check_it_out_http_localhost_5049_Chat_{1}", DataService.showUserNameWithStatus(ad.AdOwner), conversation.ID];
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["You_received_a_new_message"];
		DataService.sendEmail(emailAddress, subject, emailMessage);
		int id = conversation.ID;
		NavigationManager.NavigateTo("Chat/" + id);
	}



	public User currentlyLoggedInUser;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	/// <summary>
	/// Redirects the user to a new page showing the one specific ad they want to see
	/// </summary>
	/// <param name="ad">Ad</param>
	public void showAd(Ad ad)
	{
		int id = ad.ID;
		NavigationManager.NavigateTo("ShowAd/" + id);
	}



	Ad selectedAd;
	bool popUpForDeletingAd = false;
	string reasonForDeleting = "";

	/// <summary>
	/// Removes the ad from the database and also sends an email about it to the ad owner user (deletion done by admins)
	/// </summary>
	/// <param name="ad">Ad</param>
	/// <param name="reasonForDeleting">string</param>
	public void deleteAd(Ad ad, string reasonForDeleting)
	{
		string text = localizer["Dear_{0}_your_ad_has_been_removed_by_the_admins_for_reasons_{1}_ad_ad_type_{2}_ad_direction_{3}_address_{4}_on_{5}_available_seats_{6}_any_specific_requests_{7}", DataService.showUserNameWithStatus(ad.AdOwner), reasonForDeleting, localizer[@ad.AdType.ToString()], localizer[ad.AdDirection.ToString()], ad.PickUpDropOffLocation, ad.PickUpDateAndTime.ToString("g"), ad.NumberOfSeats, ad.SpecificRequests];
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["Your_Baxi_ad_is_deleted"];
		DataService.sendEmail(emailAddress, subject, text);
		context.Remove(ad);
		context.SaveChanges();
		reasonForDeleting = "";
		closePopUpForDeletingAd();
		grid.RefreshDataAsync();
	}

	/// <summary>
	/// Closes pop up window regarding deleting the ad
	/// </summary>
	public void closePopUpForDeletingAd()
	{
		popUpForDeletingAd = false;
	}

	/// <summary>
	/// Opens pop up window regarding deleting the ad
	/// </summary>
	public void showPopUpForDeletingAd(Ad ad)
	{
		selectedAd = ad;
		popUpForDeletingAd = true;
	}



	bool popUpForNewConversation = false;

	/// <summary>
	/// Closes pop up window regarding new conversation
	/// </summary>
	public void closePopUpForNewConversation()
	{
		popUpForNewConversation = false;
		message = "";
	}

	/// <summary>
	/// Opens pop up window regarding new conversation
	/// </summary>
	public void showPopUpForNewConversation(Ad ad)
	{
		selectedAd = ad;
		popUpForNewConversation = true;
	}


}
