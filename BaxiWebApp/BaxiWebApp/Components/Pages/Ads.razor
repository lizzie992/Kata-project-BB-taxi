<h3>Ads</h3>

@page "/Ads"
@using BB

<PageTitle>Ads</PageTitle>

<h1>Ads</h1>

<p>This page shows you the list of ads</p>

@if (false)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ad type</th>
                <th>Route</th>
                <th>Date and Time</th>
                <th>Number of seats</th>
                <th>Specific requests</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Ad in AdList)
            {

                @Ad.AdType
                <tr>
           @*          <td>@</td>
                    <td>@</td>
                    <td>@</td> *@
                </tr>
            }
        </tbody>
    </table>
}




@code {
    List<Ad> AdList = BB.LogicalCode.LoadAdListFromFile();

    void Test()
    {
        Console.WriteLine("test method :)");
    }
}
