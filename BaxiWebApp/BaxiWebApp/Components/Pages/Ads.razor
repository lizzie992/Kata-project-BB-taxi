@page "/Ads"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization;
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService


<AuthorizeView Context="authContext">
	<Authorized>

		<PageTitle>Ads</PageTitle>

		<style>

			.adList {
				display: grid;
				grid-template-columns: 33% 33% 33%;
			}

			.ad {
				box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
				max-width: 400px;
				margin: auto;
				text-align: center;
				font-family: arial;
			}

				.ad button {
					border: none;
					outline: 0;
					padding: 12px;
					color: white;
					background-color: #000;
					text-align: center;
					cursor: pointer;
					width: 100%;
					font-size: 18px;
				}


			column {
				float: left;
				padding: 10px;
			}

			.left {
				width: 50%;
			}

			.right {
				width: 50%;
			}

		</style>


		@if (currentlyLoggedInUser.isActive == false)
		{
			<p style="text-align:center; font-size:150%;">You are inactivated, this page is not available for you</p>
		}
		else
		{
			<h1 style="text-align:center;">Ads</h1>
			<p style="text-align:center; font-size:150%;">This page shows you the list of ads</p>

			<div class="row">
				<div class="column left">
					<p>I am looking for a:</p>
					<InputSelect @bind-Value="_adType" id="adType">
						@foreach (var value in Enum.GetValues<AdType>())
						{
							<option value="@value">@value.ToString()</option>
						}
					</InputSelect>
					<br>
					<br>

					<p>Direction:</p>
					<InputSelect @bind-Value="_adDirection" id="adDirection">
						@foreach (var value in Enum.GetValues<AdDirection>())
						{
							<option value="@value">@value.ToString()</option>
						}
					</InputSelect>
					<br>
					<br>


					<p>From / to this address:</p>
					<div class="search-box">
						<input type="search" autofocus @bind="_searchAddress" @bind:event="oninput" placeholder="Address..." />
					</div>
					<br>
					<br>

					<p>Between the following date and time:</p>
					<InputDate Type="InputDateType.DateTimeLocal"
							   min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime1">
					</InputDate>
					<InputDate Type="InputDateType.DateTimeLocal"
							   min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime2">
					</InputDate>
					<br>
					<br>

					<p>Requested number of seats:</p>
					<InputSelect @bind-Value="_requestedSeats" id="numberOfSeats">
						<option value="-1">All</option>
						<option value="1">1</option>
						<option value="2">2</option>
						<option value="3">3</option>
						<option value="4">4</option>
						<option value="5">5</option>
						<option value="6">6</option>
					</InputSelect>
					<br>
					<br>
					<br>
				</div>


				<div class="column right">
					<p align="center">
						<gmp-map center="48.02051251896241, 11.482662196604283"
								 zoom="10"
								 map-id="DEMO_MAP_ID"
								 style="height: 400px">
							<gmp-advanced-marker position="48.02051251896241, 11.482662196604283"
												 title="Our favourite place on the planet"></gmp-advanced-marker>

							@foreach (Ad ad in adListForMap)
							{
								<gmp-advanced-marker position="@ad.Latitude?.ToString("F8",CultureInfo.InvariantCulture), @ad.Longitude?.ToString("F8",CultureInfo.InvariantCulture)"
													 title="Ad type: @ad.AdType
Direction: @ad.AdDirection
Pick up time: @ad.PickUpDateAndTime
Number of seats: @ad.NumberOfSeats"
													 gmpClickable: true></gmp-advanced-marker>
							}

						</gmp-map>

						<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk&libraries=maps,marker&v=beta"
								defer></script>
					</p>
					<br>
					<br>
				</div>
			</div>



			<p>Click on the title of the column to sort it!</p>
			<div>
				<QuickGrid Items="FilteredAds" @ref="grid">
					<PropertyColumn Title="Ad type:" Property="@(Ad => Ad.AdType)" Sortable="true">
					</PropertyColumn>
					<PropertyColumn Title="Ad Direction:" Property="@(Ad => Ad.AdDirection)" Sortable="true">
					</PropertyColumn>
					<PropertyColumn Title="From/to this address:" Property="@(Ad => Ad.PickUpDropOffLocation)" Sortable="true">
					</PropertyColumn>
					<PropertyColumn Title="Pick up date and time:" Property="@(Ad => Ad.PickUpDateAndTime)" Sortable="true" />
					<PropertyColumn Title="Number of seats:" Property="@(Ad => Ad.NumberOfSeats)" Sortable="true" />
					<PropertyColumn Title="Specific requests:" Property="@(Ad => Ad.SpecificRequests)" Sortable="true" />
					<TemplateColumn Title="Show me the ad" Context="Ad">
						<button @onclick="() => showAd(Ad)">Show me the ad!</button>
					</TemplateColumn>
					<TemplateColumn Title="Contact" Context="Ad">
						@if (Ad.PickUpDateAndTime >= currentTime && currentlyLoggedInUser != Ad.AdOwner)
						{
							<button @onclick="() => createChat(Ad)">Contact me!</button>
						}
					</TemplateColumn>
					@if (UserManager.GetRolesAsync(currentlyLoggedInUser).Result.First() == "Admin")
					{
						<TemplateColumn Title="Delete ad" Context="Ad">
							<button @onclick="() => showPopUpForDeletingAd(Ad)">Delete this ad!</button>
						</TemplateColumn>
					}
				</QuickGrid>
			</div>


			@if (popUpForDeletingAd)
			{
				<div class="modal" tabindex="-1" style="display:block" role="dialog">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">Delete this ad!</h3>
								<button type="button" class="close" @onclick="closePopUpForDeletingAd"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>Please write here the reason for the report:</p>
								<InputText @bind-Value="reasonForDeleting"></InputText>
								<button type="button" class="close" @onclick="() => deleteAd(selectedAd, reasonForDeleting)">Delete this ad!</button>
							</div>
						</div>
					</div>
				</div>

			}
		}
	</Authorized>
</AuthorizeView>


@code {

	public Ad GetAd()
	{
		Ad ad = AdList.FirstOrDefault(ad => ad.ID == 9);
		return ad;
	}

	public static List<Ad> AdList = new List<Ad>();


	public List<Ad> adListForMap
	{
		get
		{
			var result = context.Ads.Include(a => a.AdOwner).Include(a => a.adConversations).ToList<Ad>().AsQueryable();

			result = result.Where(Ad =>
							Ad.PickUpDropOffLocation.Contains(_searchAddress, StringComparison.CurrentCultureIgnoreCase)
				&& Ad.NumberOfSeats >= _requestedSeats
				&& _datetime1 <= Ad.PickUpDateAndTime
				&& Ad.PickUpDateAndTime <= _datetime2);

			if (_adType != AdType.SelectAll)
			{
				result = result.Where(Ad => Ad.AdType == _adType);
			}
			if (_adDirection != AdDirection.SelectAll)
			{
				result = result.Where(Ad => Ad.AdDirection == _adDirection);
			}

			return result.ToList();
		}
	}


	DateTime currentTime = DateTime.Now.AddMinutes(-30);

	protected override void OnParametersSet()
	{
		AdList = context.Ads.ToList<Ad>();
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}


	// public static List<Ad> deleteOldAds(List<Ad> AdList)
	// {
	// 	AdList.RemoveAll(ad => ad.pickUpDateAndTime < DateTime.Now);
	// 	return AdList;
	// }

	string? _searchAddress = "";
	int _requestedSeats = -1;

	BB.AdType _adType = AdType.SelectAll;
	BB.AdDirection _adDirection = AdDirection.SelectAll;

	public static string allAdTypes;


	DateTime _datetime1 = DateTime.Now;
	DateTime _datetime2 = DateTime.Now.AddDays(90);


	// IQueryable<Ad>? itemsQueryable = context.Ads.ToList<Ad>().AsQueryable();


	QuickGrid<Ad>? grid;

	IQueryable<Ad> FilteredAds
	{
		get
		{
			var result = context.Ads.Include(a => a.AdOwner).Include(a => a.adConversations).ToList<Ad>().AsQueryable();

			result = result.Where(Ad =>
							Ad.PickUpDropOffLocation.Contains(_searchAddress, StringComparison.CurrentCultureIgnoreCase)
				&& Ad.NumberOfSeats >= _requestedSeats
				&& _datetime1 <= Ad.PickUpDateAndTime
				&& Ad.PickUpDateAndTime <= _datetime2);

			if (_adType != AdType.SelectAll)
			{
				result = result.Where(Ad => Ad.AdType == _adType);
			}
			if (_adDirection != AdDirection.SelectAll)
			{
				result = result.Where(Ad => Ad.AdDirection == _adDirection);
			}

			return result;
		}
	}


	public void createChat(Ad ad)
	{
		//check current ad if matching conversation exists:
		var previousConversations = ad.adConversations.AsQueryable();
		previousConversations = previousConversations.Where(Conversation => Conversation.contactingUser == currentlyLoggedInUser);
		if (previousConversations.ToList().Count != 0)
		{
			Conversation conversation = previousConversations.FirstOrDefault();
			NavigationManager.NavigateTo("Chat/" + conversation.ID);  //find id of conversation    //navigate to chat page with conversation id
		}
		else        //if not found, create new conversasion (+id)
		{
			Conversation conversation = new();
			conversation.adOwnerUser = ad.AdOwner;
			conversation.contactingUser = currentlyLoggedInUser;
			conversation.messages = new List<Message>();
			//in service
			//add new conversation boject to context
			ad.adConversations.Add(conversation);
			// savechanges
			context.SaveChanges();
			int id = conversation.ID;
			NavigationManager.NavigateTo("Chat/" + id);
		}
	}


	public User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}


	public void showAd(Ad ad)
	{
		int id = ad.ID;
		NavigationManager.NavigateTo("ShowAd/" + id);
	}



	Ad selectedAd;
	bool popUpForDeletingAd = false;
	string reasonForDeleting = "";

	public void deleteAd(Ad ad, string reasonForDeleting)
	{
		DataService.sendEmailAboutDeletingAdByAdmin(ad, reasonForDeleting);
		context.Remove(ad);
		context.SaveChanges();
		reasonForDeleting = "";
		closePopUpForDeletingAd();
		grid.RefreshDataAsync();
	}

	public void closePopUpForDeletingAd()
	{
		popUpForDeletingAd = false;
	}

	public void showPopUpForDeletingAd(Ad ad)
	{
		selectedAd = ad;
		popUpForDeletingAd = true;
	}


}
