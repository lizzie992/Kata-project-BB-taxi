@page "/Ads"
@using BB
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Data.BaxiWebAppContext context;


<PageTitle>Ads</PageTitle>

<style>

    .adList {
        display: grid;
        grid-template-columns: 33% 33% 33%;
    }

    .ad {
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        max-width: 400px;
        margin: auto;
        text-align: center;
        font-family: arial;
    }

        .ad button {
            border: none;
            outline: 0;
            padding: 12px;
            color: white;
            background-color: #000;
            text-align: center;
            cursor: pointer;
            width: 100%;
            font-size: 18px;
        }

</style>

<h1 style="text-align:center;">Ads</h1>
<p style="text-align:center; font-size:150%;">This page shows you the list of ads</p>

@if (false)
{
    <p><em>Loading...</em></p>
}
else
{
    @*  @deleteOldAds(AdList) *@

    <p>I am looking for a:</p>
    <InputSelect @bind-Value="_adType" id="adType">
        @foreach (var value in Enum.GetValues<AdType>())
        {
            <option value="@value">@value.ToString()</option>
        }
    </InputSelect>
    <br>
    <br>

    <p>On a route:</p>
    <div class="search-box">
        <input type="search" autofocus @bind="_searchRoute" @bind:event="oninput" placeholder="Route..." />
    </div>
    <br>
    <br>

    <p>Between the following date and time:</p>
    <InputDate Type="InputDateType.DateTimeLocal"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime1">
    </InputDate>
    <InputDate Type="InputDateType.DateTimeLocal"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="_datetime2">
    </InputDate>
    <br>
    <br>

    <p>Requested number of seats:</p>
    <InputSelect @bind-Value="_requestedSeats" id="numberOfSeats">
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
    </InputSelect>
    <br>


    <br>
    <br>
    <p>Click on the title of the column to sort it!</p>
    <div>
        <QuickGrid Items="FilteredAds" @ref="grid">
            <PropertyColumn Title="Ad type:" Property="@(Ad => Ad.AdType)" Sortable="true">
            </PropertyColumn>
            <PropertyColumn Title="Route:" Property="@(Ad => Ad.Route)" Sortable="true">
            </PropertyColumn>
            <PropertyColumn Title="Pick up date and time:" Property="@(Ad => Ad.pickUpDateAndTime)" Sortable="true" />
            <PropertyColumn Title="Number of seats:" Property="@(Ad => Ad.NumberOfSeats)" Sortable="true" />
            <PropertyColumn Title="Specific requests:" Property="@(Ad => Ad.SpecificRequests)" Sortable="true" />
            <TemplateColumn Title="Contact">
                <button>Contact me!</button> @* button not working yet, it should open the chat *@
            </TemplateColumn>
        </QuickGrid>
    </div>

    <br>
    <br>
    <br>
    @*  <div class="adList">
        @foreach (var Ad in AdList)
        {
            <div class="ad">
                <p>Ad type: @Ad.AdType</p>
                <p>Route: @Ad.Route</p>
                <p>Date and Time: @Ad.pickUpDateAndTime</p>
                <p>Number of seats: @Ad.NumberOfSeats</p>
                <p>Specific requests: @Ad.SpecificRequests</p>
                <p><button>Contact me!</button></p>
            </div>
        }
    </div> *@

}



@code {
    List<Ad> AdList = BB.LogicalCode.LoadAdListFromFile();

    public static List<Ad> deleteOldAds(List<Ad> AdList)
    {
        AdList.RemoveAll(ad => ad.pickUpDateAndTime < DateTime.Now);
        return AdList;
    }

    string? _searchRoute = "";
    int _requestedSeats = 1;

    BB.AdType _adType = AdType.SelectAll;

    public static string allAdTypes;


    DateTime _datetime1 = DateTime.Now;
    DateTime _datetime2 = DateTime.Now.AddDays(90);

    IQueryable<Ad>? itemsQueryable = BB.LogicalCode.LoadAdListFromFile().AsQueryable();
    QuickGrid<Ad>? grid;

    IQueryable<Ad> FilteredAds
    {
        get
        {
            var result = itemsQueryable;

            result = result.Where(Ad => 
                   Ad.Route.Contains(_searchRoute, StringComparison.CurrentCultureIgnoreCase)
                && Ad.NumberOfSeats >= _requestedSeats
                && _datetime1 <= Ad.pickUpDateAndTime
                && Ad.pickUpDateAndTime <= _datetime2);

            if (_adType != AdType.SelectAll)
            {
                result = result.Where(Ad => Ad.AdType == _adType);
            }


            return result;
        }
    }

}
