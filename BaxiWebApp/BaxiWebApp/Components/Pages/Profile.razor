@page "/Profile"
@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request
@using GoogleMapsApi.Entities.Directions.Response
@using GoogleMapsApi.Entities.Geocoding.Request
@using GoogleMapsApi.Entities.Geocoding.Response
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Globalization;
@using System.Threading.Tasks;
@using System.Text.Json;
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManager;
@inject UserManager<User> UserManager;
@inject Data.DataService DataService
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using System.Globalization;
@using Pages.Res;

<AuthorizeView>
	<Authorized>
		<style>
			#map {
				height: 100%;
			}

			column {
				float: left;
				padding: 10px;
			}

			.left {
				width: 25%;
			}

			.right {
				width: 75%;
			}
		</style>

		<PageTitle>Profile</PageTitle>


		<div class="row">
			<div class="column left">
				<div class="profileData">
					<p>@localizer["Email_address"] @user.Email</p>
					<p>@localizer["Name:"] @DataService.showUserNameWithStatus(user)</p>
					<p>@localizer["Department"] @localizer["@user.Department"]</p>
					<p>@localizer["Preferred_language"] @localizer["@user.PreferredLanguage"]</p>
					<p>@localizer["Contact"] @user.Contact</p>
					<p>@localizer["Rating"] @user.Rating</p>
					<p>@localizer["Number_of_warnings"] @user.NumberOfWarnings</p>
					<br>
					<p>@localizer["Default_data_for_creating_ads"]</p>
					<p>
						@localizer["Default_ad_type"] @if (user.DefaultAdType == AdType.SelectAll)
						{
						<p>@localizer["No_default_type"]</p>
					}
										else
					{
						<p>@localizer["@user.DefaultAdType"]</p>
					}
					</p>
					<p>@localizer["From/to_this_address"] @user.DefaultPickUpAddress</p>
					<p>@localizer["Number_of_seats"] @user.DefaultNumberOfSeats</p>
					<p>@localizer["Specific_requests"] @user.DefaultSpecificRequests</p>
					<br>
					<p>
						@localizer["Notifications"] @if (user.AreNotificationsOn == true)
						{
						<p>
							@localizer["Yes_you_will_get_notifications"]
						</p>
					}
					@if (user.AreNotificationsOn == false)
					{
						<p>
							@localizer["No_notifications_for_you"]
						</p>
					}
					</p>
					<br>
				</div>
				<a href="ProfileDataChange">
					<button>@localizer["Click_here_to_change_your_profile_data"]</button>
				</a>

				<a href="/Account/Manage/ChangePassword">
					<button>@localizer["Click_here_to_change_your_password"]</button>
				</a>

				<button @onclick="() => showPopUpForDeletingUser(user)">@localizer["Delete_my_profile"]</button>
			</div>

			<div class="column right">
				@if (user.DefaultLatitude >= 1 && user.DefaultLongitude >= 1)
				{
					<p>@localizer["Your_default_pick_up_drop_off_location_on_the_map"]</p>
					<br>
					<p align="center">
						<iframe width="600"
								height="450"
								loading="lazy"
								allowfullscreen
								src="https://www.google.com/maps/embed/v1/directions
					?key=AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk
					&origin=@user.DefaultLatitude?.ToString("F8", CultureInfo.InvariantCulture), @user.DefaultLongitude?.ToString("F8", CultureInfo.InvariantCulture)
					&destination=Givaudan,Baierbrunn+Germany
					&avoid=tolls">
						</iframe>
					</p>
				}
				else
				{
					<img src="/images/bb.jpeg" alt="Baierbrunn" style="width:600px;height:337px;">
				}
			</div>


			@if (popUpForDeletingUser)
			{
				<div class="modal" tabindex="-1" style="display:block" role="dialog">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h3 class="modal-title">@localizer["Delete_my_profile"]</h3>
								<button type="button" class="close" @onclick="closePopUpForDeletingUser"> <span area-hidden="true">X</span></button>
							</div>
							<div class="modal-body">
								<p>@localizer["Are_you_sure_you_want_to_delete_our_profile_if_you_delete_it_you_cannot_reactivate_it_again"]</p>
								<br>
								<button type="button" class="close" @onclick="() => deleteUser()">@localizer["Delete_my_profile"]</button>
							</div>
						</div>
					</div>
				</div>

			}
		</div>

	</Authorized>
</AuthorizeView>

@code {

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}

	
	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(user);
		}
	}


	private User user;
	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		user = await UserManager.GetUserAsync(claims);
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	// protected override async Task OnAfterRenderAsync(bool firstrender)
	// {
	// 	if (firstrender)
	// 	{
	// 		if (user.DefaultLatitude is not null || user.DefaultLongitude is not null)
	// 		{
	// 			await JSRuntime.InvokeVoidAsync("initMapForCreatingAd", user.DefaultLatitude, user.DefaultLongitude);
	// 		}
	// 	}
	// }

	bool popUpForDeletingUser = false;

	/// <summary>
	/// Closes pop up window to confirm if user wants to delete their profile
	/// </summary>
	public void closePopUpForDeletingUser()
	{
		popUpForDeletingUser = false;
	}
	/// <summary>
	/// Opens pop up window to confirm if user wants to delete their profile
	/// </summary>
	public void showPopUpForDeletingUser(User user)
	{
		popUpForDeletingUser = true;
	}

	/// <summary>
	/// Triggers the dataservice method to delete this user from the database
	/// </summary>
	/// <returns></returns>
	public async Task deleteUser()
	{
		DataService.deleteUser(user);
		NavigationManager.NavigateTo("/Logout", forceLoad: true);
	}


}
