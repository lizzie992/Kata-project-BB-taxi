@page "/Profile"
@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManager;
@inject UserManager<User> UserManager;
@inject Data.DataService DataService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>

        <PageTitle>Profile</PageTitle>

        <h1 style="text-align:center;">Profile data</h1>




        <div class="profileData">
            <p>Email address: @user.Email</p>
            <p>Name: @DataService.showUserNameWithStatus(user)</p>
            <p>Department: @user.Department</p>
            <p>Location: @user.Location</p>
            <p>Preferred language: @user.PreferredLanguage</p>
            <p>Contact: @user.Contact</p>
            <p>Rating: @user.Rating</p>
            <p>Number of warnings: @user.NumberOfWarnings</p>
            <br>

            <p>Here you can set up some notifications if someone is posting an ad that is convenient for you!</p>
            <a href="NotificationsForRoutes">
                <button>Click here to set up some notifications!</button>
            </a>
            <br>

            <a href="ProfileDataChange">
                <button>Click here to change your profile data!</button>
            </a>

            <a href="/Account/Manage/ChangePassword">
                <button>Click here to change your password!</button>
            </a>

            <button @onclick="() => showPopUpForDeletingUser(user)">Delete my profile!</button>

        </div>


        @if (popUpForDeletingUser)
        {
            <div class="modal" tabindex="-1" style="display:block" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h3 class="modal-title">Delete your profile</h3>
                            <button type="button" class="close" @onclick="closePopUpForDeletingUser"> <span area-hidden="true">X</span></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete our profile? If you delete it, you cannot reactivate it again!</p>
                            <br>
                            <button type="button" class="close" @onclick="() => deleteUser()">Delete my profile!</button>
                        </div>
                    </div>
                </div>
            </div>

        }


    </Authorized>
</AuthorizeView>

@code {

    private User user;
    public async Task identifyLoggedInUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var claims = authState.User;

        user = await UserManager.GetUserAsync(claims);
    }

    protected override void OnParametersSet()
    {
        identifyLoggedInUser().GetAwaiter().GetResult();
        base.OnParametersSet();
    }


    bool popUpForDeletingUser = false;

    public void closePopUpForDeletingUser()
    {
        popUpForDeletingUser = false;
    }

    public void showPopUpForDeletingUser(User user)
    {
        popUpForDeletingUser = true;
    }


    public async Task deleteUser()
    {
        DataService.deleteUser(user);
        NavigationManager.NavigateTo("/Logout", forceLoad: true);
    }


}
