@page "/Profile"
@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using GoogleMapsApi;
@using GoogleMapsApi.Entities.Common;
@using GoogleMapsApi.Entities.Directions.Request
@using GoogleMapsApi.Entities.Directions.Response
@using GoogleMapsApi.Entities.Geocoding.Request
@using GoogleMapsApi.Entities.Geocoding.Response
@using GoogleMapsApi.StaticMaps;
@using GoogleMapsApi.StaticMaps.Entities;
@using System.Globalization;
@using System.Threading.Tasks;
@using System.Text.Json;
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManager;
@inject UserManager<User> UserManager;
@inject Data.DataService DataService
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject Data.DataService DataService
@using Pages.Res;
@inject Data.BaxiWebAppContext context;
@using BaxiWebApp.Data
@inject IDbContextFactory<BaxiWebAppContext> DbContextFactory
@using Microsoft.EntityFrameworkCore

<PageTitle>@localizer["Profile"]</PageTitle>


<AuthorizeView>
	<Authorized>

		<body>

			@if (user is not null)
			{


				<div class="row">
					<div class="col-12 col-md-6">
						<div class="div-block">
							<p>@localizer["Email_address"] @user.Email</p>
							<p>@localizer["Name:"] @DataService.showUserNameWithStatus(user)</p>
							@* <p>@localizer["Department"] @localizer[@user.Department.ToString()]</p>
							<p>@localizer["Preferred_language"] @localizer[@user.PreferredLanguage.ToString()]</p> *@
							<p>@localizer["Contact"] @user.Contact</p>
							<p>@localizer["Number_of_warnings"] @user.NumberOfWarnings</p>
							<p>@localizer["Default_data_for_creating_ads"]</p>
							<p>
								@localizer["Default_ad_type"]
								@if (user.DefaultAdType == AdType.SelectAll)
								{
									@localizer["No_default_type"]
								}
								else
								{
									@localizer[@user.DefaultAdType.ToString()]
								}
							</p>
							<p>@localizer["From/to_this_address"] @user.DefaultPickUpAddress</p>
							<p>@localizer["Number_of_seats"] @user.DefaultNumberOfSeats</p>
							<p>@localizer["Specific_requests"] @user.DefaultSpecificRequests</p>
							<p>
								@localizer["Notifications"]
								@if (user.AreNotificationsOn == true)
								{
									@localizer["Yes_you_will_get_notifications"]
								}
								@if (user.AreNotificationsOn == false)
								{
									@localizer["No_notifications_for_you"]
								}
							</p>
							<a href="ProfileDataChange">
								<button>@localizer["Click_here_to_change_your_profile_data"]</button>
							</a>
							<a href="/Account/Manage/ChangePassword">
								<button>@localizer["Click_here_to_change_your_password"]</button>
							</a>
							<button @onclick="() => showPopUpForDeletingUser(user)">@localizer["Delete_my_profile"]</button>
						</div>
					</div>


					@if (user.DefaultLatitude >= 1 && user.DefaultLongitude >= 1)
					{
						<div class="col-12 col-md-6">
							<div id="map">
							</div>
							<script>
								(g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})
								({key: "AIzaSyANS3CV3B_21cbYSCLWxTr0gOZpJSPmnvk", v: "beta"});</script>

						</div>

					}
				</div>
			}
		</body>


		@* //new pop up for deleting user: *@
		<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="exampleModalLabel">@localizer["Delete_my_profile"]</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<p>@localizer["Are_you_sure_you_want_to_delete_our_profile_if_you_delete_it_you_cannot_reactivate_it_again"]</p>
					</div>
					<div class="modal-footer">
						<button type="button" data-bs-dismiss="modal" class="close" @onclick="() => deleteUser()">@localizer["Delete_my_profile"]</button>
					</div>
				</div>
			</div>
		</div>



	</Authorized>
</AuthorizeView>

@code {

	protected override void OnInitialized() => DataService.CultureChanged += OnCultureChanged;

	public async void OnCultureChanged(object? sender, CultureInfo culture)
	{

		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}


	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			if (user?.DefaultLatitude >= 1 && user.DefaultLongitude >= 1)
			{
				try
				{
					await JSRuntime.InvokeVoidAsync("initMapForOnePin", localizer["Your_default_pick_up_drop_off_location_on_the_map up"].ToString(), user.DefaultLatitude, user.DefaultLongitude);
				}
				catch (ArgumentException e)
				{
					Console.WriteLine($"Map failed to display: {e.Message}");
				}
			}
		}


	}

	[CascadingParameter(Name = "currentlyLoggedInUser")]
	private User? user { get; set; }



	protected override void OnParametersSet()
	{
		DataService.loadCulture(user);
		base.OnParametersSet();
	}

	protected override bool ShouldRender()
	{
		if (user is not null)
		{
			DataService.loadCulture(user);
		}
		return base.ShouldRender();
	}



	bool popUpForDeletingUser = false;

	/// <summary>
	/// Closes pop up window to confirm if user wants to delete their profile
	/// </summary>
	public void closePopUpForDeletingUser()
	{
		popUpForDeletingUser = false;
	}
	/// <summary>
	/// Opens pop up window to confirm if user wants to delete their profile
	/// </summary>
	public async void showPopUpForDeletingUser(User user)
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("blazorModal.show", "deleteUserModal");
		}
		catch (ArgumentException e)
		{
			Console.WriteLine($"Modal failed to display: {e.Message}");
		}

	}

	/// <summary>
	/// Triggers the dataservice method to delete this user from the database
	/// </summary>
	/// <returns></returns>
	public void deleteUser()
	{
		DataService.deleteUser(user);
		user = null;
		NavigationManager.NavigateTo("/Logout", forceLoad: true);
	}


}
