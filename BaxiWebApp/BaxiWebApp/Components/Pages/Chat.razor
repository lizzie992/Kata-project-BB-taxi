@page "/Chat/{ID:int}"
@page "/Chat"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager

@* <h3>Chat</h3> *@

<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<style>
		* {
		box-sizing: border-box;
		}

		column {
		float: left;
		padding: 10px;
		}

		.left {
		width: 25%;
		}

		.right {
		width: 75%;
		}


		.clickable-div {
		width: 100%;
		height: 150px;
		background-color: lightblue;
		cursor: pointer;
		text-align: center;
		line-height: 150px;
		border-width: 1px;
		border-style: solid;
		border-color: #E70000;
		}

		a {
		text-decoration: none;
		display: block;
		width: 100%;
		height: 100%;
		}

	</style>
</head>
<body>
	<div class="row">
		<div class="column left" style="background-color:#aaa;">
			<h2>All chat conversations</h2>
			<p>
				@foreach (Conversation C in convoList)
				{
					<div class="clickable-div">
						<a href="Chat/@C.ID">@C.adOwnerUser</a>
					</div>
				}
			</p>
		</div>
		<div class="column right" style="background-color:#bbb;">
			<h2>Chat</h2>
			<p>
				@if (CurrentConversation is null)
				{
					<p>Click on a chat!</p>
				}
				else
				{
					@foreach (Message M in messages)
					{
						<div class="Message">
							<p>From: @M.fromUser</p>
							<p>To: @M.toUser</p>
							<p>Message: @M.messageText</p>
							<p>Timestamp: @M.timeStamp</p>
						</div>
						<br>
					}
					<InputText @bind-Value="textMessage"></InputText>
					<button class="btn btn-primary" @onclick="sendMessage">Send</button>
				}
			</p>
		</div>
	</div>

</body>






@code {

	[Parameter]
	public int? ID { get; set; }

	public Conversation? CurrentConversation
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).FirstOrDefault(conversation => conversation.ID == ID);
			return result;
		}
	}

	public List<Message> messages
	{
		get
		{
			var result = context.Messages.ToList<Message>();
			result = result.FindAll(message => message.ConversationID == CurrentConversation.ID);
			return result;
		}
	}


	public IQueryable<Conversation> convoList
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).ToList<Conversation>().AsQueryable();
			result = result.Where(c => c.adOwnerUser == currentlyLoggedInUser || c.contactingUser == currentlyLoggedInUser);
			return result;
		}
	}

	

	private string textMessage;

	public void sendMessage()
	{
		Message message = new Message();
		message.fromUser = currentlyLoggedInUser;
		if (currentlyLoggedInUser == CurrentConversation._contactingUser)
		{
			message.toUser = CurrentConversation._adOwnerUser;
		}
		if (currentlyLoggedInUser == CurrentConversation._adOwnerUser)
		{
			message.toUser = CurrentConversation._contactingUser;
		}
		message.messageText = textMessage;
		message.timeStamp = DateTime.Now;
		CurrentConversation.conversation.Add(message);
		context.SaveChanges();

		//you dont need it here but youll need it soon
		//StateHasChanged();
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

}
