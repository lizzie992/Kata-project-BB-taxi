@page "/Chat/{ID:int}"
@page "/Chat"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Net.Mail
@using System.Net
@using System.IO
@using System.Text;
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService

@* <h3>Chat</h3> *@

<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<style>
		* {
		box-sizing: border-box;
		}

		column {
		float: left;
		padding: 10px;
		}

		.left {
		width: 25%;
		}

		.right {
		width: 75%;
		}


		.clickable-div {
		width: 100%;
		height: 150px;
		background-color: lightblue;
		cursor: pointer;
		text-align: center;
		line-height: 150px;
		border-width: 1px;
		border-style: solid;
		border-color: #E70000;
		}

		a {
		text-decoration: none;
		display: block;
		width: 100%;
		height: 100%;
		}

	</style>
</head>
<body>


	<div class="row">
		<div class="column left" style="background-color:#aaa;">
			<h2>All chat conversations</h2>
			@foreach (Conversation C in ConvoList)
			{
				<div class="clickable-div">
					@if (C.messages is not null)
					{
						<a href="Chat/@C.ID">@C.MostRecentMessage.messageText.ToString() @C.MostRecentMessage.timeStamp.ToString("yyyy-MM-dd HH:mm")</a>
					}
					else
					{
						<a href="Chat/@C.ID">New conversation</a>
					}
				</div>
			}
		</div>
		<div class="column right" style="background-color:#bbb;">
			<h2>Chat</h2>
			<p>
				@if (CurrentConversation is null)
				{
					<p>Click on a chat!</p>
				}
				else
				{
					@if (CurrentConversation.adOwnerUser == currentlyLoggedInUser || CurrentConversation.contactingUser == currentlyLoggedInUser)
					{
						Ad ad = GetAd(CurrentConversation);
						<div class="Ad">
							<p>Ad owner: @ad.AdOwner</p>
							<p>Ad type: @ad.AdType</p>
							<p>Route: @ad.Route</p>
							<p>Pick up Date and Time: @ad.pickUpDateAndTime</p>
							<p>Number of seats: @ad.NumberOfSeats</p>
							<p>Specific requests: @ad.SpecificRequests</p>
							<br>
							<br>
							<br>
						</div>
						@foreach (Message M in CurrentConversation.messages)
						{
							<div class="Message">
								<p>From: @M.fromUser</p>
								<p>To: @M.toUser</p>
								<p>Message: @M.messageText</p>
								<p>Timestamp: @M.timeStamp</p>
							</div>
							<br>
						}
						<InputText @bind-Value="TextMessage"></InputText>
						<button class="btn btn-primary" @onclick="SendMessage">Send</button>
						<br>
						<br>
						<button class="btn btn-primary" @onclick="() => DeleteConversation(CurrentConversation)">Delete conversation</button>
						<button class="btn btn-primary" @onclick="() => ReportConversation(CurrentConversation)">Report conversation</button>
					}
					else
					{
						<p>Looks like you are lost :) Please navigate back to the chat using the navigation menu on the left!</p>
					}
				}
			</p>
		</div>
	</div>
</body>






@code {

	[Parameter]
	public int? ID { get; set; }

	public Conversation? CurrentConversation
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).FirstOrDefault(conversation => conversation.ID == ID);
			return result;
		}
	}




	// public List<Message> currentMessages
	// {
	// 	get
	// 	{
	// 		var result = context.Messages.ToList<Message>();
	// 		result = result.FindAll(message => message.ConversationID == CurrentConversation.ID);
	// 		return result;
	// 	}
	// }


	public IQueryable<Conversation>? ConvoList
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).Include(c => c.messages).ToList<Conversation>().AsQueryable();
			result = result.Where(c => c.adOwnerUser == currentlyLoggedInUser || c.contactingUser == currentlyLoggedInUser);
			result = result.OrderByDescending(c => c.MostRecentMessage.timeStamp);
			return result;
		}
	}



	private string TextMessage { get; set; }



	public void SendMessage()
	{
		DataService.SendMessage(CurrentConversation, currentlyLoggedInUser, TextMessage, CurrentConversation.ID);
		TextMessage = "";
	}

	protected override void OnParametersSet()
	{
		IdentifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	public async Task IdentifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}


	public void DeleteConversation(Conversation C)
	{
		//first delete the messages that have the ID of this current conversation as long as the current conversation exists
		IEnumerable<Message> messagesToDelete = context.Messages.ToList<Message>().AsEnumerable();
		messagesToDelete = messagesToDelete.Where(m => m.ConversationID == C.ID);
		context.Messages.RemoveRange(messagesToDelete);
		//once the messages are removed I can delete the conversation
		context.Conversations.Remove(C);
		context.SaveChanges();
		NavigationManager.NavigateTo("Chat");
	}

	public void ReportConversation(Conversation C)
	{
		IEnumerable<Message> messagesToReport = context.Messages.ToList<Message>().AsEnumerable();
		messagesToReport = messagesToReport.Where(m => m.ConversationID == C.ID);
		StringBuilder message = new StringBuilder($"Messages: \r\n\r\n");
		foreach (Message m in messagesToReport)
		{
			message.Append($"From: {m.fromUser.ToString()}\r\n");
			message.Append($"To: {m.toUser.ToString()}\r\n");
			message.Append($"Message: {m.messageText.ToString()}\r\n");
			message.Append($"Timestamp: {m.timeStamp.ToString()}\r\n\r\n");
		}
		string output = message.ToString();

		SmtpClient client = new SmtpClient("smtp.gmail.com", 587);
		client.EnableSsl = true;
		client.UseDefaultCredentials = false;
		string passw = Environment.GetEnvironmentVariable("BBtaxi_email_password");
		client.Credentials = new NetworkCredential("baierbrunntaxi@gmail.com", passw);
		MailMessage mailMessage = new MailMessage();
		mailMessage.From = new MailAddress("baierbrunntaxi@gmail.com");
		mailMessage.To.Add("gulyaskata99@gmail.com");
		mailMessage.Body = $"Please check out the following conversation below that {currentlyLoggedInUser} reported to you: \r\n{message}";
		mailMessage.Subject = "A conversation was just reported to you";
		client.Send(mailMessage);
	}


	public Ad GetAd(Conversation C)
	{
		Ad ad = context.Ads.Where(a => a.adConversations.Contains(C)).First();
		return ad;
	}


}
