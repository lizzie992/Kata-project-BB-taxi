@page "/Chat/{ID:int}"
@page "/Chat"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Net.Mail
@using System.Net
@using System.IO
@using System.Text;
@using System.Globalization;
