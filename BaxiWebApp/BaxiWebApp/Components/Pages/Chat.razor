@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject IJSRuntime JSRuntime;


<PageTitle>@localizer["Chat"]</PageTitle>


<body>
	@* desktop mode *@
	<div class="row-chat-laptop">
		<div class="col">
			<div class="col-all-convos">
				<h2 style="text-align: center">@localizer["All_chat_conversations"]</h2>
				@if (ConvoList == null || ConvoList.Count == 0)
				{
					<p>@localizer["No_conversations_yet"]</p>
				}
				else
				{
					foreach (Conversation C in ConvoList)
					{
						<a href="Chat/@C.ID">
							<div class="convo-preview">
								@if (C.MostRecentMessage is not null)
								{
									<div class="convo-other-user">@DataService.showUserNameWithStatus(DataService.getOtherUser(C, currentlyLoggedInUser))</div>
									<div class="convo-last-message">@C.MostRecentMessage.messageText.ToString()</div>
									<div class="convo-timestamp">@C.MostRecentMessage.timeStamp.ToString("g")</div>
								}
								else
								{
									<p>@localizer["New_conversation"]</p>
								}
							</div>
						</a>
					}
				}
			</div>
		</div>

		<div class="col">
			<div class="col-chat">

				@if (CurrentConversation is null)
				{
					<div style="text-align: center">@localizer["Click_on_a_chat"]</div>
				}
				else
				{
					@if (CurrentConversation.adOwnerUser == currentlyLoggedInUser || CurrentConversation.contactingUser == currentlyLoggedInUser)
					{
						Ad? ad = GetAd(CurrentConversation);
						@if (ad is null)
						{
							<div class="actions-for-chat">
								<p style="text-align:center">@localizer["This_ad_must_have_been_deleted"]</p>
								<button type="button" data-bs-toggle="modal" data-bs-target="#deleteConvoModal">
									@localizer["Delete_conversation"]
								</button>
								<button type="button" data-bs-toggle="modal" data-bs-target="#reportConvoModal">
									@localizer["Report_conversation"]
								</button>
							</div>
						}
						else
						{
							<div class="actions-for-chat">
								<div class="ad-description">@localizer["In_this_conversation_you_are_talking_to_{0}_to_arrange_a_ride_{1}_from_to_{2}_on_{3}_including_{4}_passengers", DataService.showUserNameWithStatus(ad.AdOwner), localizer[ad.AdDirection.ToString()], ad.PickUpDropOffLocation, ad.PickUpDateAndTime.ToString("g"), ad.NumberOfSeats]</div>
								<button @onclick="() => showAd(ad)">@localizer["Show_me_the_ad"]</button>
								@* <button @onclick="() => showPopUpForDeletingConversation(CurrentConversation)">@localizer["Delete_conversation"]</button> *@
								<button type="button" data-bs-toggle="modal" data-bs-target="#deleteConvoModal">
									@localizer["Delete_conversation"]
								</button>
								@* <button @onclick="() => showPopUpForReportConversation(CurrentConversation)">@localizer["Report_conversation"]</button> *@
								<button type="button" data-bs-toggle="modal" data-bs-target="#reportConvoModal">
									@localizer["Report_conversation"]
								</button>
							</div>
						}
						<div class="message-block">
							@if (CurrentConversation.messages is null)
							{
								<p>@localizer["New_conversation"]</p>
							}
							else
							{
								@foreach (Message M in CurrentConversation.messages)
								{
									if (currentlyLoggedInUser == M.fromUser)
									{
										<div class="message-right">
											<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
											<div class="message">@M.messageText</div>
											<div class="timestamp">@M.timeStamp.ToString("g")</div>
										</div>
									}
									if (currentlyLoggedInUser == M.toUser)
									{
										<div class="message-left">
											<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
											<div class="message">@M.messageText</div>
											<div class="timestamp">@M.timeStamp.ToString("g")</div>
										</div>
									}
								}
							}

						</div>
					}
					else
					{
						<p>@localizer["Looks_like_you_are_lost_please_navigate_back_to_the_chat_using_the_navigation_menu_on_the_left"]</p>
					}
					@if (currentlyLoggedInUser?.isActive == true)
					{
						<div class="chat-send">
							<textarea class="chat-input" @bind="TextMessage" @bind:event="oninput" @onkeydown="Enter"></textarea>
							<button class="chat-button" @onclick="SendMessage">@localizer["Send"]</button>
						</div>
					}
				}
			</div>
		</div>
	</div>

