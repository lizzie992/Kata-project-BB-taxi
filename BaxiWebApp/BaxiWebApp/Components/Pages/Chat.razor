@page "/Chat/{ID:int}"
@page "/Chat"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Net.Mail
@using System.Net
@using System.IO
@using System.Text;
@using System.Globalization
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager
@inject Data.DataService DataService
@using Pages.Res;
@using System.Linq;
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Resources> localizer
@inject IJSRuntime JSRuntime;

<body>
	@* desktop mode *@
	<div class="row-chat-laptop">
		<div class="col">
			<div class="col-all-convos">
				<h2 style="text-align: center">@localizer["All_chat_conversations"]</h2>
				@if (ConvoList == null || ConvoList.Count == 0)
				{
					<p>@localizer["No_conversations_yet"]</p>
				}
				else
				{
					foreach (Conversation C in ConvoList)
					{
						<a href="Chat/@C.ID">
							<div class="convo-preview">
								@if (C.MostRecentMessage is not null)
								{
									<div class="convo-other-user">@DataService.showUserNameWithStatus(DataService.getOtherUser(C, currentlyLoggedInUser))</div>
									<div class="convo-last-message">@C.MostRecentMessage.messageText.ToString()</div>
									<div class="convo-timestamp">@C.MostRecentMessage.timeStamp.ToString("g")</div>
								}
								else
								{
									<p>@localizer["New_conversation"]</p>
								}
							</div>
						</a>
					}
				}
			</div>
		</div>

		<div class="col">
			<div class="col-chat">

				@if (CurrentConversation is null)
				{
					<div style="text-align: center">@localizer["Click_on_a_chat"]</div>
				}
				else
				{
					@if (CurrentConversation.adOwnerUser == currentlyLoggedInUser || CurrentConversation.contactingUser == currentlyLoggedInUser)
					{
						Ad ad = GetAd(CurrentConversation);
						<div class="actions-for-chat">
							<div class="ad-description">@localizer["In_this_conversation_you_are_talking_to_{0}_to_arrange_a_ride_{1}_from_to_{2}_on_{3}_including_{4}_passengers", DataService.showUserNameWithStatus(ad.AdOwner), localizer[ad.AdDirection.ToString()], ad.PickUpDropOffLocation, ad.PickUpDateAndTime.ToString("g"), ad.NumberOfSeats]</div>
							<button @onclick="() => showAd(ad)">@localizer["Show_me_the_ad"]</button>
							<button @onclick="() => showPopUpForDeletingConversation(CurrentConversation)">@localizer["Delete_conversation"]</button>
							<button @onclick="() => showPopUpForReportConversation(CurrentConversation)">@localizer["Report_conversation"]</button>
						</div>
						<div class="message-block">
							@foreach (Message M in CurrentConversation.messages)
							{
								if (currentlyLoggedInUser == M.fromUser)
								{
									<div class="message-right">
										<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
										<div class="message">@M.messageText</div>
										<div class="timestamp">@M.timeStamp.ToString("g")</div>
									</div>
								}
								if (currentlyLoggedInUser == M.toUser)
								{
									<div class="message-left">
										<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
										<div class="message">@M.messageText</div>
										<div class="timestamp">@M.timeStamp.ToString("g")</div>
									</div>
								}
							}

						</div>
					}
					else
					{
						<p>@localizer["Looks_like_you_are_lost_please_navigate_back_to_the_chat_using_the_navigation_menu_on_the_left"]</p>
					}
					@if (currentlyLoggedInUser.isActive == true)
					{
						<div class="chat-send">
							<InputText class="chat-input" @bind-Value="TextMessage"></InputText>
							<button class="chat-button" @onclick="SendMessage">@localizer["Send"]</button>
						</div>
					}
				}
			</div>
		</div>
	</div>

	@* phone mode *@
	<div class="row-chat-mobile">
		@if (CurrentConversation is null)
		{
			<div class="col-all-convos">
				<h2 style="text-align: center">@localizer["All_chat_conversations"]</h2>
				@if (ConvoList == null || ConvoList.Count == 0)
				{
					<p>@localizer["No_conversations_yet"]</p>
				}
				else
				{
					foreach (Conversation C in ConvoList)
					{
						<a href="Chat/@C.ID">
							<div class="convo-preview">
								@if (C.MostRecentMessage is not null)
								{
									<div class="convo-other-user">@DataService.showUserNameWithStatus(DataService.getOtherUser(C, currentlyLoggedInUser))</div>
									<div class="convo-last-message">@C.MostRecentMessage.messageText.ToString()</div>
									<div class="convo-timestamp">@C.MostRecentMessage.timeStamp.ToString("g")</div>
								}
								else
								{
									<p>@localizer["New_conversation"]</p>
								}
							</div>
						</a>
					}
				}
			</div>
		}
		else
		{
			<button class="chat-back-button" @onclick="backToChat">@localizer["Back_to_the_chat"]</button>
			<div class="col-chat">
				@if (CurrentConversation.adOwnerUser == currentlyLoggedInUser || CurrentConversation.contactingUser == currentlyLoggedInUser)
				{
					Ad ad = GetAd(CurrentConversation);
					<div class="actions-for-chat">
						<div class="ad-description">@localizer["In_this_conversation_you_are_talking_to_{0}_to_arrange_a_ride_{1}_from_to_{2}_on_{3}_including_{4}_passengers", DataService.showUserNameWithStatus(ad.AdOwner), localizer[ad.AdDirection.ToString()], ad.PickUpDropOffLocation, ad.PickUpDateAndTime.ToString("g"), ad.NumberOfSeats]</div>
						<button @onclick="() => showAd(ad)">@localizer["Show_me_the_ad"]</button>
						<button @onclick="() => showPopUpForDeletingConversation(CurrentConversation)">@localizer["Delete_conversation"]</button>
						<button @onclick="() => showPopUpForReportConversation(CurrentConversation)">@localizer["Report_conversation"]</button>
					</div>
					<div class="message-block-phone">
						@foreach (Message M in CurrentConversation.messages)
						{
							if (currentlyLoggedInUser == M.fromUser)
							{
								<div class="message-right">
									<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
									<div class="message">@M.messageText</div>
									<div class="timestamp">@M.timeStamp.ToString("g")</div>
								</div>
							}
							if (currentlyLoggedInUser == M.toUser)
							{
								<div class="message-left">
									<div class="from-user">@localizer["From"] @DataService.showUserNameWithStatus(M.fromUser)</div>
									<div class="message">@M.messageText</div>
									<div class="timestamp">@M.timeStamp.ToString("g")</div>
								</div>
							}
						}
					</div>
				}
				else
				{
					<p>@localizer["Looks_like_you_are_lost_please_navigate_back_to_the_chat_using_the_navigation_menu_on_the_left"]</p>
				}
				@if (currentlyLoggedInUser.isActive == true)
				{
					<div class="chat-send">
						<InputText class="chat-input" @bind-Value="TextMessage"></InputText>
						<button class="chat-button" @onclick="SendMessage">@localizer["Send"]</button>
					</div>
				}
			</div>
		}
	</div>
</body>


@if (popUpForDeletingConversation)
{
	<div class="modal" tabindex="-1" style="display:block" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h3 class="modal-title">@localizer["Delete_conversation"]</h3>
					<button type="button" class="close" @onclick="closePopUpForDeletingConversation"> <span area-hidden="true">X</span></button>
				</div>
				<div class="modal-body">
					<p>@localizer["Are_you_sure_you_want_to_delete_it"]</p>
					<button type="button" class="close" @onclick="() => DeleteConversation(CurrentConversation)">@localizer["Delete_conversation"]</button>
				</div>
			</div>
		</div>
	</div>

}


@if (popUpForReportConversation)
{
	<div class="modal" tabindex="-1" style="display:block" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h3 class="modal-title">@localizer["Report_this_conversations_to_the_admins"]</h3>
					<button type="button" class="close" @onclick="closePopUpForReportConversation"> <span area-hidden="true">X</span></button>
				</div>
				<div class="modal-body">
					<p>@localizer["Please_write_here_the_reason_for_the_report"]</p>
					<InputText @bind-Value="reasonForReporting"></InputText>
					<button type="button" class="close" @onclick="() => ReportConversation(CurrentConversation, currentlyLoggedInUser, reasonForReporting)">@localizer["Report_conversation"]</button>
				</div>
			</div>
		</div>
	</div>
}






@code {

	[Parameter]
	public int? ID { get; set; }
	Conversation selectedConvo;
	private string TextMessage { get; set; }
	string reasonForReporting = "";

	protected override void OnInitialized()
	{
		DataService.ChatChanged += OnChatChanged;
		DataService.CultureChanged += OnCultureChanged;
	}

	public async void OnCultureChanged(object sender, CultureInfo culture)
	{
		await InvokeAsync(() =>
		{
			StateHasChanged();
		});
	}



	protected override async Task OnAfterRenderAsync(bool firstrender)
	{
		if (firstrender)
		{
			DataService.loadCulture(currentlyLoggedInUser);
		}
		if (CurrentConversation is not null)
		{
			await JSRuntime.InvokeVoidAsync("scrollToBottom");
			await JSRuntime.InvokeVoidAsync("scrollToBottomPhone");
		}
	}



	/// <summary>
	/// In case of event ChatChanged, it triggers a Statehaschanged to re-render the component
	/// </summary>
	/// <param name="sender"></param>
	/// <param name="contactID"></param>
	public async void OnChatChanged(object sender, int contactID)
	{
		await InvokeAsync(() =>
	{
		StateHasChanged();
	});
	}

	/// <summary>
	/// Redirects the user to a new page showing the one specific ad they want to see
	/// </summary>
	/// <param name="ad">Ad</param>
	public void showAd(Ad ad)
	{
		int id = ad.ID;
		NavigationManager.NavigateTo("ShowAd/" + id);
	}

	/// <summary>
	/// Redirects the user to the main chat page - no chat selected
	/// </summary>
	public void backToChat()
	{
		NavigationManager.NavigateTo("Chat");
	}



	protected override void OnParametersSet()
	{
		IdentifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	/// <summary>
	/// Identifies the user who is currently logged in
	/// </summary>
	/// <returns>User</returns>
	public User currentlyLoggedInUser;
	public async Task IdentifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

	public Conversation? CurrentConversation
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).FirstOrDefault(conversation => conversation.ID == ID);
			return result;
		}
	}

	public List<Conversation> ConvoList
	{
		get
		{
			List<Conversation> result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).Include(c => c.messages).ToList();
			result = result
		.Where(c => c.adOwnerUser.Id == currentlyLoggedInUser.Id || c.contactingUser.Id == currentlyLoggedInUser.Id)
		.ToList();
			if (result.Count() == 0)
			{
				return null;
			}
			result = result.OrderByDescending(c => c.MostRecentMessage.timeStamp).ToList();
			return result.ToList();
		}

	}




	/// <summary>
	/// Adds the current string as a message to the current conversation and also resets the textmessage to an empty string for the next message
	/// </summary>
	public void SendMessage()
	{
		User fromUser = DataService.getOtherUser(CurrentConversation, currentlyLoggedInUser);
		string emailMessage = localizer["You_just_received_a_new_message_from_{0}_Go_and_check_it_out_http_localhost_5049_Chat_{1}", DataService.showUserNameWithStatus(fromUser), CurrentConversation.ID];
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["You_received_a_new_message"];
		DataService.SendChatMessage(CurrentConversation, currentlyLoggedInUser, TextMessage, CurrentConversation.ID);
		DataService.sendEmail(emailAddress, subject, emailMessage);
		TextMessage = "";
	}

	/// <summary>
	/// Triggers the dataservice method to delete the conversation object and redirects the user to the main chat page
	/// </summary>
	/// <param name="C"></param>
	public void DeleteConversation(Conversation C)
	{
		DataService.DeleteConversation(C);
		closePopUpForDeletingConversation();
		NavigationManager.NavigateTo("Chat");
	}

	/// <summary>
	/// Triggers the dataservice method to report the given conversation to the admins
	/// </summary>
	/// <param name="C">Conversation object</param>
	/// <param name="currentlyLoggedInUser">User object</param>
	/// <param name="reasonForReporting">String</param>
	public void ReportConversation(Conversation C, User currentlyLoggedInUser, string reasonForReporting)
	{
		IEnumerable<Message> messagesToReport = context.Messages.Include(m => m.fromUser).Include(m => m.toUser).ToList<Message>().AsEnumerable();
		messagesToReport = messagesToReport.Where(m => m.ConversationID == C.ID).OrderBy(c => c.timeStamp); 
		StringBuilder message = new StringBuilder();
		foreach (Message m in messagesToReport)
		{
			message.Append(localizer["From"]);
			message.Append($"{DataService.showUserNameWithStatus(m.fromUser)}\r\n");
			message.Append(localizer["To"]);
			message.Append($"{DataService.showUserNameWithStatus(m.toUser)}\r\n");
			message.Append(localizer["Message"]);
			message.Append($"{m.messageText.ToString()}\r\n");
			message.Append(localizer["Timestamp"]);
			message.Append($"{m.timeStamp.ToString()}\r\n\r\n");
		}
		string output = message.ToString();
		string emailAddress = "gulyaskata99@gmail.com";
		string subject = localizer["A_conversation_was_just_reported_to_you"];
		string text = localizer["Please_check_out_the_following_conversation_below_that_{0}_reported_to_you_with_the_following_reason_{1}_messages_{2}", currentlyLoggedInUser, reasonForReporting, message];
		DataService.sendEmail(emailAddress, subject, text);

		reasonForReporting = "";
		closePopUpForReportConversation();
	}

	/// <summary>
	/// Find the Ad which the given conversation belongs to in the database
	/// </summary>
	/// <param name="C">Conversation object</param>
	/// <returns>Ad object</returns>
	public Ad GetAd(Conversation C)
	{
		Ad ad = context.Ads.Where(a => a.adConversations.Contains(C)).First();
		return ad;
	}



	bool popUpForDeletingConversation = false;
	/// <summary>
	/// Closes pop up window about deleting a conversation
	/// </summary>
	public void closePopUpForDeletingConversation()
	{
		popUpForDeletingConversation = false;
	}
	/// <summary>
	/// Opens pop up window about deleting a conversation
	/// </summary>
	/// <param name="C">Conversation object</param>
	public void showPopUpForDeletingConversation(Conversation C)
	{
		selectedConvo = C;
		popUpForDeletingConversation = true;
	}



	bool popUpForReportConversation = false;
	/// <summary>
	/// Closes pop up window about reporting a conversation
	/// </summary>
	public void closePopUpForReportConversation()
	{
		popUpForReportConversation = false;
	}
	/// <summary>
	/// Opens pop up window about reporting a conversation
	/// </summary>
	/// <param name="C">Conversation object</param>
	public void showPopUpForReportConversation(Conversation C)
	{
		selectedConvo = C;
		popUpForReportConversation = true;
	}


}
