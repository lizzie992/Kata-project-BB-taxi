@page "/Chat/{ID:int}"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager

@* <h3>Chat</h3> *@

<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<style>
		* {
		box-sizing: border-box;
		}

		column {
		float: left;
		padding: 10px;
		}

		.left {
		width: 25%;
		}

		.right {
		width: 75%;
		}

	</style>
</head>
<body>
	<div class="row">
		<div class="column left" style="background-color:#aaa;">
			<h2>All chat conversations</h2>
			<p>
				@foreach (Conversation C in convoList)
				{
					<div class="Conversation">
						<p>@C.adOwnerUser</p>
					</div>
					<br>
				}
			</p>
		</div>
		<div class="column right" style="background-color:#bbb;">
			<h2>Chat</h2>
			<p>
				@foreach (Message M in conversation.conversation)
				{
					<div class="Message">
						<p>From: @M.fromUser</p>
						<p>To: @M.toUser</p>
						<p>Message: @M.messageText</p>
						<p>Timestamp: @M.timeStamp</p>
					</div>
					<br>
				}
				<InputText @bind-Value="textMessage"></InputText>
				<button class="btn btn-primary" @onclick="sendMessage">Send</button>
			</p>
		</div>
	</div>

</body>






@code {

	[Parameter]
	public int ID { get; set; }

	public Conversation conversation
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).FirstOrDefault(conversation => conversation.ID == ID);
			return result;
		}
	}

	public IQueryable<Conversation> convoList
	{
		get
		{
			var result = context.Conversations.Include(c => c.adOwnerUser).Include(c => c.contactingUser).ToList<Conversation>().AsQueryable();
			result = result.Where(c => c.adOwnerUser == currentlyLoggedInUser || c.contactingUser == currentlyLoggedInUser);
			return result;
		}
	}


	public void defineList()
	{
		conversation.conversation = context.Messages.ToList<Message>();
		conversation.conversation = conversation.conversation.FindAll(message => message.ConversationID == conversation.ID);
	}

	private string textMessage;

	public void sendMessage()
	{
		Message message = new Message();
		message.fromUser = currentlyLoggedInUser;
		if (currentlyLoggedInUser == conversation._contactingUser)
		{
			message.toUser = conversation._adOwnerUser;
		}
		if (currentlyLoggedInUser == conversation._adOwnerUser)
		{
			message.toUser = conversation._contactingUser;
		}
		message.messageText = textMessage;
		message.timeStamp = DateTime.Now;
		conversation.conversation.Add(message);
		context.SaveChanges();

		//you dont need it here but youll need it soon 
		//StateHasChanged();
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		defineList();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

}
