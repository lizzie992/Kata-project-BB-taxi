	private string textMessage;
	private List<Message> conversation = new List<Message>();

	public void sendMessage()
	{
		Message message = new Message();
		// message.fromUser = currentlyLoggedInUser;
		// message.toUser = 
		// message.messageText = textMessage;
		// message.timeStamp = DateTime.Now;
		conversation.Add(message);
		context.SaveChanges();
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

