@page "/Chat/{ID:int}"

@using BB
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject Data.BaxiWebAppContext context;
@inject AuthenticationStateProvider AuthStateProvider;
@inject SignInManager<User> signInManger;
@inject UserManager<User> UserManager;
@inject NavigationManager NavigationManager

<h3>Chat</h3>






<InputText @bind-Value="textMessage"></InputText>
<button class="btn btn-primary" @onclick="sendMessage">Send</button>


@code {

	private string textMessage;
	private static Message message { get; set; } = new();
	private List<Message> conversation { get; set; } = new();

	public void sendMessage()
	{
		message = new Message();
		// message.fromUser = currentlyLoggedInUser;
		// message.toUser = 
		// message.messageText = textMessage;
		// message.timeStamp = DateTime.Now;
		conversation.Add(message);
		context.SaveChanges();
	}

	protected override void OnParametersSet()
	{
		identifyLoggedInUser().GetAwaiter().GetResult();
		base.OnParametersSet();
	}

	public User currentlyLoggedInUser;
	public async Task identifyLoggedInUser()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();

		var claims = authState.User;

		currentlyLoggedInUser = await UserManager.GetUserAsync(claims);
	}

}
